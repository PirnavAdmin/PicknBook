.admin-search-history-page {
  gap: 12px;
}

.admin-search-history-header h1 {
  font-size: 1.88rem;
}

.admin-search-history-chip {
  background: var(--admin-success-soft);
  border-color: var(--admin-border);
  color: var(--admin-success);
}

.admin-search-history-toolbar .admin-actions-row {
  gap: 6px;
}

.admin-search-history-delete {
  background: linear-gradient(135deg, var(--admin-primary), var(--admin-primary-strong)) !important;
  color: #ffffff !important;
}

.admin-search-filters {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.admin-search-history-table-shell {
  border: 1px solid var(--admin-border);
  border-radius: 13px;
  overflow: hidden;
  background: var(--admin-surface);
  box-shadow: 0 10px 20px rgba(16, 34, 58, 0.08);
}

.admin-search-history-table-head {
  display: grid;
  grid-template-columns: 0.42fr 0.88fr 0.78fr 1.8fr 0.9fr;
  gap: 8px;
  padding: 8px;
  background: #be185d !important;
}

.admin-search-history-table-head span {
  min-height: 32px;
  background: transparent !important;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 0.8rem;
  font-weight: 700;
  text-align: center;
}

.admin-search-history-table-body {
  display: grid;
}

.admin-search-history-row {
  display: grid;
  grid-template-columns: 0.42fr 0.88fr 0.78fr 1.8fr 0.9fr;
  gap: 8px;
  padding: 8px;
  border-top: 1px solid var(--admin-border);
}

.admin-search-history-cell {
  min-height: 56px;
  border: 1px solid var(--admin-border);
  border-radius: 10px;
  background: var(--admin-surface);
  padding: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  gap: 3px;
  color: var(--admin-text);
  font-size: 0.81rem;
}

.admin-search-history-cell strong {
  color: var(--admin-text);
  font-size: 0.81rem;
  font-weight: normal;
}

.admin-search-history-empty {
  min-height: 220px;
  display: grid;
  place-items: center;
  color: var(--admin-muted);
  font-size: 1.02rem;
  background: var(--admin-surface);
}

.admin-search-history-pagination {
  min-height: 42px;
  border-top: 1px solid var(--admin-border);
  background: var(--admin-soft);
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 6px;
  padding: 0 10px;
  flex-wrap: wrap;
}

.admin-search-history-pagination button {
  min-width: 34px;
  min-height: 30px;
  border: 1px solid var(--admin-border);
  border-radius: 8px;
  background: var(--admin-surface);
  color: var(--admin-text);
  font-size: 0.83rem;
  font-weight: 700;
  cursor: pointer;
}

.admin-search-history-pagination button.active {
  border-color: var(--admin-primary);
  background: linear-gradient(135deg, var(--admin-primary), var(--admin-primary-strong));
  color: #fff;
}

.admin-search-history-pagination button:disabled {
  opacity: 0.55;
  cursor: not-allowed;
}

@media (max-width: 1100px) {
  .admin-search-filters {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 820px) {
  .admin-search-history-table-head,
  .admin-search-history-row {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 620px) {
  .admin-search-filters {
    grid-template-columns: 1fr;
  }

  .admin-search-history-table-head,
  .admin-search-history-row {
    grid-template-columns: 1fr;
  }
}

.admin-search-history-chip {
  background: rgba(190, 24, 93, 0.05) !important;
  border-color: #be185d !important;
  color: #be185d !important;
  padding: 6px 14px !important;
  border-radius: 100px !important;
  font-weight: 600 !important;
}

.admin-search-history-toolbar .admin-actions-row button {
  background: #ffffff !important;
  color: #be185d !important;
  border: 1.5px solid #be185d !important;
  border-radius: 20px !important;
  padding: 6px 16px !important;
  font-weight: 600 !important;
  cursor: pointer !important;
  transition: all 0.2s ease-in-out !important;
}

.admin-search-history-toolbar .admin-actions-row button:hover {
  background: #be185d !important;
  color: #ffffff !important;
  box-shadow: 0 4px 12px rgba(190, 24, 93, 0.2) !important;
}

.admin-search-history-delete {
  background: #be185d !important;
  color: #ffffff !important;
  border: 1.5px solid #be185d !important;
  border-radius: 20px !important;
  padding: 6px 16px !important;
  font-weight: 600 !important;
  cursor: pointer !important;
  transition: all 0.2s ease-in-out !important;
}

.admin-search-history-delete:hover {
  background: #9d124d !important;
  border-color: #9d124d !important;
  box-shadow: 0 4px 12px rgba(190, 24, 93, 0.2) !important;
}
