.bus-markup-list-page-container {
  --admin-primary: #A51C49 !important;
  --admin-primary-strong: #851237 !important;
  padding-top: 24px !important;
  margin-top: 0px !important;
}

.markup-heading {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: 4px;
}

.bus-markup-list-page-container .markup-heading-main {
  margin: 0;
  font-size: 22px !important;
  font-weight: 700 !important;
  color: var(--admin-primary) !important;
  letter-spacing: 0.02em;
}

.bus-markup-list-page-container .markup-heading-sub {
  font-size: 22px !important;
  font-weight: 700 !important;
  color: #000000 !important;
  margin-left: 8px !important;
}

/* ═══════════════════════════════════
   TOOLBAR  — matches DiscountList toolbar
   ═══════════════════════════════════ */
.markup-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 16px;
  flex-wrap: wrap;
}

.markup-toolbar-group {
  display: flex;
  gap: 16px;
  align-items: flex-end;
  flex-wrap: wrap;
}

.markup-toolbar-actions {
  display: flex;
  gap: 10px;
  align-items: flex-end;
  justify-content: flex-end;
  flex-wrap: wrap;
}

.bus-markup-list-page-container .markup-field {
  display: flex !important;
  flex-direction: column !important;
  gap: 6px !important;
  font-size: 12px !important;
  color: var(--admin-muted) !important;
}

.bus-markup-list-page-container .markup-field span {
  font-weight: 700 !important;
  text-transform: uppercase !important;
  font-size: 10px !important;
  letter-spacing: 0.05em !important;
  color: #000000 !important;
}

.markup-field input,
.markup-field select {
  border: 1px solid var(--admin-border);
  border-radius: 8px;
  padding: 6px 10px;
  font-size: 13px;
  color: var(--admin-text);
  background: #ffffff;
  min-width: 140px;
  min-height: 32px;
}

/* Primary "Add New" button */
.markup-primary-btn {
  border: 1.5px solid #A51C49 !important;
  background: #A51C49 !important;
  color: #fff !important;
  padding: 10px 16px;
  border-radius: 10px;
  font-weight: 600;
  font-size: 13px;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 7px;
  white-space: nowrap;
  box-shadow: 0 4px 10px rgba(194, 24, 91, 0.15) !important;
  transition: all 0.25s ease !important;
}

.markup-primary-btn:hover {
  background: #851237 !important;
  border-color: #851237 !important;
  transform: translateY(-3px) !important;
  box-shadow: 0 6px 18px rgba(194, 24, 91, 0.3) !important;
}

/* Export button */
.markup-export-btn {
  border: 1.5px solid #A51C49 !important;
  background: #A51C49 !important;
  color: #fff !important;
  padding: 10px 16px;
  border-radius: 10px;
  font-weight: 600;
  font-size: 13px;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 7px;
  white-space: nowrap;
  box-shadow: 0 4px 10px rgba(194, 24, 91, 0.15) !important;
  transition: all 0.25s ease !important;
}

.markup-export-btn:hover:not(:disabled) {
  background: #851237 !important;
  border-color: #851237 !important;
  transform: translateY(-3px) !important;
  box-shadow: 0 6px 18px rgba(194, 24, 91, 0.3) !important;
}

.markup-export-btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

/* ═══════════════════════════════════
   STAT CARDS  — reuse from Discount List
   ═══════════════════════════════════ */
.stats-row {
  display: flex;
  gap: 16px;
  align-items: stretch;
  flex-wrap: wrap;
}

.bus-markup-list-page-container .stat-card {
  border: 1px solid var(--admin-border);
  border-radius: 12px;
  padding: 8px 14px !important;
  background: #ffffff !important;
  box-shadow: 0 4px 14px rgba(16, 16, 16, 0.06);
  flex: 0 1 220px !important;
  max-width: 220px !important;
  transition: all 0.3s ease !important;
  cursor: pointer !important;
}

.bus-markup-list-page-container .stat-card:hover {
  transform: translateY(-4px) !important;
  box-shadow: 0 12px 24px rgba(15, 23, 42, 0.12) !important;
  border-color: var(--admin-primary) !important;
}

.bus-markup-list-page-container .stat-label {
  font-size: 12px !important;
  color: var(--admin-muted) !important;
  font-weight: 600 !important;
}

.bus-markup-list-page-container .stat-card.total .stat-label { color: var(--admin-primary) !important; }
.bus-markup-list-page-container .stat-card.active .stat-label { color: var(--admin-success) !important; }
.bus-markup-list-page-container .stat-card.inactive .stat-label { color: #ef4444 !important; }

.bus-markup-list-page-container .stat-value {
  font-size: 20px !important;
  font-weight: 700 !important;
  margin: 4px 0 !important;
  color: var(--admin-text) !important;
}

.bus-markup-list-page-container .stat-meta {
  font-size: 11px !important;
  color: var(--admin-muted) !important;
}

/* keep legacy header styles below for view-details screen */
.admin-markup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
  margin-bottom: 8px;
}



.admin-markup-header h1 {
  margin: 0;
  font-size: 26px;
  color: var(--admin-primary) !important;
  font-weight: 700;
  letter-spacing: 0.02em;
}

.admin-markup-header h1 strong {
  color: var(--admin-primary) !important;
  font-weight: 700;
}

.admin-markup-header-actions {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}

.admin-markup-filter-btn,
.admin-markup-export-btn {
  border: 1px solid var(--border);
  background: var(--panel);
  color: var(--text-primary);
  padding: 8px 14px;
  border-radius: 10px;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  cursor: pointer;
  transition: 0.2s ease;
}

.admin-markup-filter-btn.primary,
.admin-markup-export-btn.primary {
  background: var(--admin-primary) !important;
  color: white !important;
  border-color: var(--admin-primary) !important;
  box-shadow: 0 4px 10px rgba(30, 117, 255, 0.2) !important;
}

.admin-markup-filter-btn.primary:hover,
.admin-markup-export-btn.primary:hover:not(:disabled) {
  background: var(--admin-primary-strong) !important;
  border-color: var(--admin-primary-strong) !important;
}

.admin-markup-filter-btn.active,
.admin-markup-filter-btn:hover,
.admin-markup-export-btn:hover:not(.primary) {
  border-color: var(--admin-primary) !important;
  color: var(--admin-primary) !important;
  background: var(--surface-soft) !important;
}

.admin-markup-export-btn.primary:disabled {
  opacity: 0.6;
  cursor: not-allowed;
  box-shadow: none !important;
}

.filter-chevron {
  transition: transform 0.2s ease;
}

.filter-chevron.open {
  transform: rotate(180deg);
}

.admin-markup-filter-panel {
  margin-top: 12px;
  border: 1px solid var(--border);
  border-radius: 14px;
  background: var(--panel);
  padding: 14px;
  box-shadow: var(--shadow-sm);
  margin-bottom: 8px;
}

.admin-markup-filter-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 12px;
}

.admin-markup-filter-grid label {
  display: grid;
  gap: 6px;
  font-size: 0.82rem;
  color: var(--text-secondary);
}

.admin-markup-filter-grid label span {
  font-weight: 700;
  text-transform: uppercase;
  font-size: 10px;
  letter-spacing: 0.05em;
  color: var(--text-secondary);
}

.admin-markup-filter-grid select {
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 8px 10px;
  background: var(--panel);
  color: var(--text-primary);
  font-size: 0.85rem;
}

.admin-markup-filter-actions {
  margin-top: 12px;
  display: flex;
  justify-content: flex-end;
}

.admin-markup-filter-reset {
  border: 1px solid var(--border);
  background: var(--surface-soft);
  color: var(--text-primary);
  padding: 8px 14px;
  border-radius: 10px;
  font-weight: 600;
  cursor: pointer;
}

.admin-markup-table-wrap {
  margin-top: 14px;
  border: 1px solid var(--border);
  border-radius: 16px;
  background: var(--panel);
  box-shadow: var(--shadow-sm);
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  overflow: visible !important;
}

.admin-markup-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.88rem;
  table-layout: auto;
}

/* Ensure status column always has enough room for the pill */
.admin-markup-table th:nth-child(8),
.admin-markup-table td:nth-child(8) {
  min-width: 90px;
  overflow: visible !important;
  white-space: nowrap;
}

.admin-markup-table thead {
  background: var(--admin-primary) !important;
  color: #ffffff;
}

.admin-markup-table th {
  background: var(--admin-primary) !important;
  padding: 12px 8px !important;
  font-size: 11px;
  font-weight: 700;
  color: #ffffff !important;
  border-bottom: 1px solid #e2e8f0;
  text-transform: uppercase;
  letter-spacing: 0.02em !important;
  white-space: nowrap;
  overflow: visible !important;
  text-overflow: unset !important;
  text-align: center;
}

.admin-markup-table td.action-col {
  overflow: visible !important;
  position: relative;
}

.admin-markup-table td {
  padding: 10px 8px;
  border-bottom: 1px solid var(--border);
  text-align: center;
  vertical-align: middle;
  overflow: visible;
}

.admin-markup-table tbody tr:hover {
  background: #f8fafc;
}

.admin-markup-table th.action-col,
.admin-markup-table td.action-col {
  text-align: center;
  overflow: visible !important;
}

/* Status cell — never clip the pill badge */
.admin-markup-table td:nth-child(8) {
  overflow: visible !important;
  white-space: nowrap;
}

.admin-markup-empty {
  padding: 18px;
  text-align: center;
  color: var(--text-secondary);
  font-weight: 600;
}

.markup-id-chip {
  border: 1px solid var(--border);
  background: var(--surface-soft);
  color: var(--text-primary);
  padding: 6px 10px;
  border-radius: 999px;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  cursor: pointer;
}

.markup-id-chip-icon {
  height: 16px;
  width: 16px;
  border-radius: 50%;
  background: var(--primary);
  color: #ffffff;
  display: grid;
  place-items: center;
  font-size: 0.75rem;
}

.markup-status-toggle {
  border: 1px solid transparent;
  background: var(--surface-soft);
  color: var(--text-primary);
  padding: 5px 12px;
  border-radius: 999px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 5px;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  cursor: pointer;
  white-space: nowrap;
  line-height: 1.4;
  box-sizing: border-box;
  flex-shrink: 0;
}

.markup-status-toggle svg {
  flex-shrink: 0;
  width: 12px !important;
  height: 12px !important;
}

.markup-status-toggle.active {
  background: #ecfdf5 !important;
  color: #10b981 !important;
  border-color: rgba(16, 185, 129, 0.25) !important;
}

.markup-status-toggle.inactive {
  background: #fef2f2 !important;
  color: #ef4444 !important;
  border-color: rgba(239, 68, 68, 0.25) !important;
}

.markup-remark-cell {
  max-width: 220px;
}

.markup-remark-text {
  display: block;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  color: var(--text-secondary);
}

.markup-action-group {
  display: inline-flex;
  gap: 8px;
}

.markup-action-group button {
  border: 1px solid var(--border);
  background: var(--panel);
  color: var(--text-primary);
  padding: 6px;
  border-radius: 8px;
  cursor: pointer;
  transition: 0.2s ease;
}

.markup-action-group button:hover {
  border-color: var(--primary);
  color: var(--primary);
  background: var(--surface-soft);
}

.markup-action-group button.danger {
  color: var(--danger);
  border-color: rgba(180, 35, 24, 0.35);
  background: var(--danger-soft);
}

.admin-markup-view-screen {
  display: grid;
  gap: 16px;
}

.admin-markup-view-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
}

.admin-markup-view-top h2 {
  margin: 0;
  font-size: 20px;
  color: var(--primary);
  font-weight: 700;
}

.admin-markup-view-top h2 strong {
  color: inherit;
  font-weight: inherit;
}

.admin-markup-view-actions {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

.admin-markup-view-btn {
  border: 1px solid var(--border);
  background: var(--panel);
  color: var(--text-primary);
  padding: 8px 14px;
  border-radius: 10px;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  cursor: pointer;
}

.admin-markup-view-btn.primary {
  background: var(--primary);
  color: white;
  border: none;
}

.admin-markup-view-btn.primary:hover {
  background: var(--primary-strong);
}

.admin-markup-view-underline {
  height: 1px;
  background: var(--border);
}

.admin-markup-view-card {
  border: 1px solid var(--border);
  border-radius: 16px;
  background: var(--panel);
  padding: 16px;
  box-shadow: var(--shadow-sm);
}

.admin-markup-view-band {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 12px;
  border-radius: 999px;
  background: var(--surface-soft);
  color: var(--primary);
  font-weight: 700;
}

.admin-markup-view-table-wrap {
  margin-top: 14px;
  overflow: hidden;
}

.admin-markup-view-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.88rem;
}

.admin-markup-view-table td {
  padding: 10px 12px;
  border-bottom: 1px solid var(--border);
}

.admin-markup-view-table td:last-child {
  border-right: none;
}

/* ══════════════════════════════════════
   ACTIONS DROPDOWN STYLES
   ══════════════════════════════════════ */
.actions-dropdown-container {
  position: relative;
  display: inline-block;
}

.actions-trigger-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: #f8fafc;
  border: 1px solid #cbd5e1;
  color: #475569;
  padding: 5px 12px;
  border-radius: 6px;
  font-size: 11px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
  white-space: nowrap;
}

.actions-trigger-btn:hover,
.actions-trigger-btn.active {
  background: #f1f5f9;
  border-color: #94a3b8;
  color: #1e293b;
}

.actions-trigger-btn .chevron-icon {
  font-size: 8px;
  transition: transform 0.2s ease;
}

.actions-trigger-btn.active .chevron-icon {
  transform: rotate(180deg);
}

.actions-dropdown-menu {
  position: absolute;
  right: 0;
  margin-top: 4px;
  width: 150px;
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
  z-index: 50;
  overflow: hidden;
  animation: dropdownFadeIn 0.15s ease-out;
}

@keyframes dropdownFadeIn {
  from {
    opacity: 0;
    transform: translateY(-4px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.dropdown-item {
  display: flex;
  align-items: center;
  gap: 8px;
  width: 100%;
  padding: 8px 12px;
  border: none;
  background: transparent;
  font-size: 11px;
  font-weight: 600;
  text-align: left;
  cursor: pointer;
  color: #64748b;
  transition: all 0.15s ease;
}

.dropdown-item .item-icon {
  font-size: 11px;
  transition: color 0.15s ease;
}

/* Hover States with Curated Micro-Interactions */
.dropdown-item.view:hover {
  background: #eff6ff;
  color: #2563eb;
}
.dropdown-item.view:hover .item-icon {
  color: #2563eb;
}

.dropdown-item.edit:hover {
  background: #eff6ff;
  color: #2563eb;
}
.dropdown-item.edit:hover .item-icon {
  color: #2563eb;
}

.dropdown-item.delete:hover {
  background: #eff6ff;
  color: #2563eb;
}
.dropdown-item.delete:hover .item-icon {
  color: #2563eb;
}

.admin-markup-view-table td.label {
  color: var(--text-secondary);
  font-weight: 600;
  text-transform: uppercase;
  font-size: 0.7rem;
  letter-spacing: 0.04em;
}

.admin-markup-view-table td.value {
  color: var(--text-primary);
  font-weight: 600;
}

.remark-value {
  max-width: 320px;
}

.remark-text {
  color: var(--text-secondary);
}

.admin-markup-modal-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(20, 5, 5, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1200;
  padding: 16px;
}

.admin-markup-modal {
  background: var(--panel);
  border-radius: 16px;
  border: 1px solid var(--border);
  box-shadow: 0 24px 48px rgba(15, 23, 42, 0.22);
  width: min(720px, 95vw);
  padding: 16px;
}

.admin-markup-modal.fullscreen {
  width: min(900px, 95vw);
}

.admin-markup-modal.small {
  width: min(480px, 95vw);
}

.admin-markup-modal header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding-bottom: 10px;
  border-bottom: 1px solid var(--border);
}

.admin-markup-modal header h2 {
  margin: 0;
  font-size: 1.1rem;
  color: var(--text-primary);
}

.admin-markup-modal header button {
  border: 1px solid var(--border);
  background: var(--surface-soft);
  color: var(--text-primary);
  border-radius: 10px;
  padding: 4px 8px;
  cursor: pointer;
}

.admin-markup-form-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 12px;
  margin-top: 14px;
}

.admin-markup-form-grid label {
  display: grid;
  gap: 6px;
  font-size: 0.82rem;
  color: var(--text-secondary);
}

.admin-markup-form-grid label span {
  font-weight: 700;
  text-transform: uppercase;
  font-size: 10px;
  letter-spacing: 0.05em;
  color: var(--text-secondary);
}

.admin-markup-form-grid input,
.admin-markup-form-grid select,
.admin-markup-form-grid textarea {
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 8px 10px;
  font-size: 0.85rem;
  background: var(--panel);
  color: var(--text-primary);
}

.admin-markup-form-grid textarea {
  min-height: 90px;
  resize: vertical;
}

.admin-markup-form-grid .wide {
  grid-column: 1 / -1;
}

.admin-markup-form-error {
  margin: 12px 0 0;
  color: var(--danger);
  font-weight: 600;
}

.admin-markup-modal-actions {
  display: flex;
  justify-content: flex-end;
  gap: 10px;
  margin-top: 16px;
}

.admin-markup-modal-actions button {
  border: 1px solid var(--border);
  padding: 10px 20px;
  border-radius: 10px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.25s ease !important;
}

.admin-markup-modal-actions button.primary {
  background: #A51C49 !important;
  color: white !important;
  border-color: #A51C49 !important;
  box-shadow: 0 4px 12px rgba(194, 24, 91, 0.15) !important;
}

.admin-markup-modal-actions button.primary:hover {
  background: #851237 !important;
  border-color: #851237 !important;
  transform: translateY(-3px) !important;
  box-shadow: 0 6px 18px rgba(194, 24, 91, 0.3) !important;
}

.admin-markup-modal-actions .secondary {
  background: var(--surface-soft);
  color: var(--text-primary);
}

.admin-markup-modal-actions .secondary:hover {
  transform: translateY(-3px) !important;
}

.admin-markup-modal-actions .danger {
  background: var(--danger-soft);
  color: var(--danger);
  border-color: rgba(180, 35, 24, 0.35);
}

.admin-markup-modal.fullscreen.inline-card-container {
  width: 100% !important;
  max-width: 100% !important;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.03) !important;
  border-radius: 16px !important;
  border: 1px solid var(--border) !important;
  background: var(--panel) !important;
  padding: 32px !important;
  box-sizing: border-box !important;
  display: flex !important;
  flex-direction: column !important;
  gap: 20px !important;
  margin-top: 10px !important;
}

.admin-markup-delete-copy {
  margin: 16px 0 0;
  color: var(--text-secondary);
}

@media (max-width: 900px) {
  .admin-markup-table thead {
    display: none;
  }

  .admin-markup-table tr {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 10px;
    padding: 12px;
    border-bottom: 1px solid var(--border);
  }

  .admin-markup-table td {
    border-bottom: 0;
  }
}

