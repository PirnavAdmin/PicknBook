.tax-management {
  display: flex;
  flex-direction: column;
  gap: 8px;
  color: #000;
}

.tax-heading {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.tax-title {
  margin: 0;
  font-size: 20px;
  font-weight: 600;
}

.tax-underline {
  display: inline-block;
  width: 140px;
  height: 3px;
  background: #f08b1a;
}

.tax-form {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.tax-grid {
  display: grid;
  grid-template-columns: 150px minmax(160px, 1fr) 150px minmax(160px, 1fr) 140px minmax(160px, 1fr);
  gap: 0;
  border: 1px solid #cfd8e3;
  background: #fff;
}

.label-cell {
  background: #d9f1ff;
  border: 1px dashed #4aa3df;
  font-size: 12px;
  font-weight: 600;
  padding: 6px 8px;
  display: flex;
  align-items: center;
}

.input-cell {
  border: 1px solid #cfd8e3;
  padding: 4px 6px;
  background: #fff;
}

.input-cell input {
  width: 100%;
  border: 1px solid #d7dde6;
  height: 28px;
  padding: 2px 6px;
  font-size: 12px;
  color: #333;
  box-sizing: border-box;
}

.input-cell input::placeholder {
  color: #9aa6b2;
}

.input-cell.span-5 {
  grid-column: span 5;
}

.terms-header {
  display: flex;
  align-items: center;
  border-radius: 4px;
  overflow: hidden;
  height: 26px;
  border: 1px solid #c8d6e5;
}

.terms-title {
  background: #0b1f8f;
  color: #fff;
  font-size: 13px;
  font-weight: 600;
  padding: 3px 12px;
  letter-spacing: 0.02em;
}

.terms-fill {
  flex: 1;
  height: 100%;
  background: linear-gradient(135deg, #bfe3d9 0%, #bfe3d9 55%, #a4d4e7 55%, #a4d4e7 70%, #8bcfc2 70%, #8bcfc2 100%);
}

.editor-shell {
  border: 1px solid #cfd8e3;
  background: #fff;
}

.editor-toolbar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 6px;
  padding: 6px;
  background: #f6f6f6;
  border-bottom: 1px solid #d5d5d5;
}

.editor-toolbar.secondary {
  background: #f9f9f9;
}

.tool-btn {
  border: 1px solid #c6c6c6;
  background: #fff;
  font-size: 11px;
  padding: 2px 6px;
  min-width: 26px;
  height: 26px;
  cursor: pointer;
}

.tool-btn:hover {
  background: #eef4ff;
}

.tool-btn.active {
  background: #e6f0ff;
  border-color: #7fa5d6;
}

.tool-btn.bold {
  font-weight: 700;
}

.tool-btn.italic {
  font-style: italic;
}

.tool-btn.underline {
  text-decoration: underline;
}

.tool-select {
  border: 1px solid #c6c6c6;
  height: 26px;
  padding: 0 6px;
  font-size: 11px;
  background: #fff;
}

.tool-divider {
  width: 1px;
  height: 18px;
  background: #c6c6c6;
  margin: 0 2px;
}

.editor-body {
  border-top: 1px solid #d5d5d5;
}

.editor-area {
  min-height: 240px;
  padding: 12px;
  font-size: 13px;
  outline: none;
}

.editor-source {
  width: 100%;
  min-height: 240px;
  padding: 12px;
  border: none;
  resize: vertical;
  font-size: 12px;
  font-family: "Courier New", monospace;
  box-sizing: border-box;
}

.tax-actions {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  padding-top: 6px;
}

.submit-btn {
  border: 2px solid #f08b1a;
  background: #fff;
  padding: 6px 18px;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.08em;
  cursor: pointer;
  border-radius: 6px;
  text-transform: uppercase;
}

.submit-btn:hover {
  background: #fff4e6;
}

.status-text {
  font-size: 12px;
  color: #1a7f37;
}

@media (max-width: 1200px) {
  .tax-grid {
    grid-template-columns: 140px 1fr;
  }

  .input-cell.span-5 {
    grid-column: span 1;
  }
}

@media (max-width: 600px) {
  .tax-title {
    font-size: 18px;
  }

  .tax-underline {
    width: 110px;
  }

  .terms-title {
    font-size: 12px;
  }
}
