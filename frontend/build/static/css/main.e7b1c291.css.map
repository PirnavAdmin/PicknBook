.admin-flight-cancel-title {
  margin: 0;
  display: inline-flex;
  align-items: baseline;
  gap: 8px;
}

.admin-flight-cancel-title strong {
  position: relative;
  display: inline-flex;
  align-items: baseline;
}

.admin-flight-cancel-title strong::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: -6px;
  height: 3px;
  border-radius: 999px;
  background: var(--admin-primary);
  opacity: 0.9;
}

.admin-flight-cancel-actions .admin-flight-btn {
  min-height: 34px;
  border: 0;
  border-radius: 10px;
  padding: 0 12px;
  color: #fff;
  font-size: 0.84rem;
  font-weight: 800;
  cursor: pointer;
}

.admin-flight-cancel-actions .admin-flight-btn-filter {
  background: linear-gradient(135deg, var(--admin-primary), var(--admin-primary-strong));
}

.admin-flight-cancel-actions .admin-flight-btn-clear {
  background: linear-gradient(135deg, var(--admin-primary), var(--admin-primary-strong));
}

.admin-flight-cancel-actions .admin-flight-btn-export {
  background: linear-gradient(135deg, var(--admin-primary), var(--admin-primary-strong));
}

.admin-flight-cancel-page .admin-flight-cancel-table-head,
.admin-flight-cancel-page .admin-flight-cancel-table-row {
  grid-template-columns: 1.05fr 1.25fr 1.1fr 0.7fr 0.8fr 0.8fr 1.55fr 0.65fr;
}

.admin-flight-cancel-footnote {
  min-height: 34px;
  border-top: 1px solid var(--admin-border);
  background: var(--admin-success-soft);
  color: var(--admin-success);
  font-size: 0.86rem;
  padding: 8px 10px;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  flex-wrap: wrap;
  font-weight: 700;
}

@media (max-width: 820px) {
  .admin-flight-cancel-page .admin-flight-cancel-table-head,
  .admin-flight-cancel-page .admin-flight-cancel-table-row {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 620px) {
  .admin-flight-cancel-page .admin-flight-cancel-table-head,
  .admin-flight-cancel-page .admin-flight-cancel-table-row {
    grid-template-columns: 1fr;
  }
}

.admin-flight-cancel-actions .admin-flight-btn {
  background: #ffffff !important;
  color: #be185d !important;
  border: 1.5px solid #be185d !important;
  border-radius: 20px !important;
  padding: 6px 16px !important;
  font-weight: 600 !important;
  cursor: pointer !important;
  transition: all 0.2s ease-in-out !important;
  min-height: 34px !important;
}

.admin-flight-cancel-actions .admin-flight-btn:hover {
  background: #be185d !important;
  color: #ffffff !important;
  box-shadow: 0 4px 12px rgba(190, 24, 93, 0.2) !important;
}

