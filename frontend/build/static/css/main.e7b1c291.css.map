.bus-discount-list-page-container {
  --admin-primary: #A51C49 !important;
  --admin-primary-strong: #851237 !important;
}

.discount-heading {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.bus-discount-list-page-container .discount-heading-main {
  margin: 0;
  font-size: 22px !important;
  font-weight: 700 !important;
  color: var(--admin-primary) !important;
  letter-spacing: 0.02em;
}

.bus-discount-list-page-container .discount-heading-sub {
  font-size: 22px !important;
  font-weight: 700 !important;
  color: #000000 !important;
  margin-left: 8px !important;
}

.bus-discount-list-page-container .stats-row {
  display: flex;
  gap: 16px;
  align-items: stretch;
  flex-wrap: wrap;
}

.bus-discount-list-page-container .stat-card {
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 8px 14px !important;
  background: var(--panel) !important;
  box-shadow: 0 8px 20px rgba(15, 23, 42, 0.08);
  flex: 0 1 220px !important;
  max-width: 220px !important;
  transition: all 0.3s ease !important;
  cursor: pointer !important;
}

.bus-discount-list-page-container .stat-card:hover {
  transform: translateY(-4px) !important;
  box-shadow: 0 12px 24px rgba(15, 23, 42, 0.12) !important;
  border-color: var(--admin-primary) !important;
}

.bus-discount-list-page-container .stat-label {
  font-size: 12px !important;
  color: var(--muted) !important;
}

.bus-discount-list-page-container .stat-card.total .stat-label {
  color: var(--admin-primary) !important;
}

.bus-discount-list-page-container .stat-card.active .stat-label {
  color: var(--admin-success) !important;
}

.bus-discount-list-page-container .stat-card.inactive .stat-label {
  color: #ef4444 !important;
}

.bus-discount-list-page-container .stat-value {
  font-size: 20px !important;
  font-weight: 600 !important;
  margin: 4px 0 !important;
}

.bus-discount-list-page-container .stat-meta {
  font-size: 11px !important;
  color: var(--muted) !important;
}

.bus-discount-list-page-container .toolbar {
  display: flex !important;
  justify-content: space-between !important;
  align-items: flex-end !important;
  gap: 16px !important;
  flex-wrap: wrap !important;
  margin-top: 8px !important;
}

.bus-discount-list-page-container .toolbar-group {
  display: flex !important;
  gap: 16px !important;
  align-items: flex-end !important;
  flex-wrap: wrap !important;
}

.bus-discount-list-page-container .toolbar-actions {
  display: flex !important;
  gap: 12px !important;
  align-items: flex-end !important;
  justify-content: flex-end !important;
  flex-wrap: wrap !important;
}

.bus-discount-list-page-container .field {
  display: flex !important;
  flex-direction: column !important;
  gap: 6px !important;
  font-size: 12px !important;
  color: var(--muted) !important;
}

.bus-discount-list-page-container .field span {
  font-weight: 700 !important;
  text-transform: uppercase !important;
  font-size: 10px !important;
  letter-spacing: 0.05em !important;
  color: #000000 !important;
}

.bus-discount-list-page-container .search-input-wrapper {
  position: relative !important;
  display: flex !important;
  align-items: center !important;
  width: 100% !important;
}

.bus-discount-list-page-container .search-icon {
  position: absolute !important;
  left: 12px !important;
  color: #94a3b8 !important;
  font-size: 14px !important;
  pointer-events: none !important;
}

.bus-discount-list-page-container .field input,
.bus-discount-list-page-container .field select {
  border: 1px solid var(--admin-primary) !important;
  border-radius: 8px !important;
  padding: 8px 12px !important;
  font-size: 13px !important;
  color: #1e293b !important;
  background: #ffffff !important;
  min-width: 180px !important;
  min-height: 38px !important;
  width: 100% !important;
  transition: all 0.2s ease !important;
}

.bus-discount-list-page-container .search-input-wrapper input {
  padding-left: 36px !important;
}

.bus-discount-list-page-container .field input:hover,
.bus-discount-list-page-container .field select:hover {
  border-color: var(--admin-primary) !important;
}

.bus-discount-list-page-container .field input:focus,
.bus-discount-list-page-container .field select:focus {
  border-color: var(--admin-primary) !important;
  box-shadow: 0 0 0 3px rgba(194, 24, 91, 0.15) !important;
  outline: none !important;
  background: #ffffff !important;
}

.bus-discount-list-page-container .field input[type="text"] {
  min-width: 480px !important;
}

.bus-discount-list-page-container .primary-btn {
  height: 38px !important;
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  padding: 0 18px !important;
  border-radius: 8px !important;
  font-size: 13px !important;
  font-weight: 600 !important;
  transition: all 0.2s ease !important;
  box-shadow: 0 4px 10px rgba(15, 23, 42, 0.08) !important;
  background: #A51C49 !important;
  border: 1.5px solid #A51C49 !important;
  color: #ffffff !important;
}

.bus-discount-list-page-container .primary-btn:hover {
  background: #851237 !important;
  border-color: #851237 !important;
  color: #ffffff !important;
  transform: translateY(-3px) !important;
  box-shadow: 0 6px 14px rgba(165, 28, 73, 0.3) !important;
}

.bus-discount-list-page-container .field.wide {
  grid-column: 1 / -1;
}

.add-panel {
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 18px 20px;
  background: var(--panel);
  box-shadow: 0 10px 24px rgba(15, 23, 42, 0.08);
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.add-panel-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16px;
  flex-wrap: wrap;
}

.add-panel-title {
  font-size: 18px;
  font-weight: 600;
  margin: 0;
}

.add-panel-subtitle {
  font-size: 13px;
  color: var(--muted);
  margin: 6px 0 0;
}

.add-form {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 14px;
  align-items: end;
}

.form-actions {
  display: flex;
  gap: 10px;
  justify-content: flex-end;
  align-items: center;
  grid-column: 1 / -1;
}

.details-panel {
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 18px 20px;
  background: var(--panel);
  box-shadow: 0 12px 28px rgba(17, 17, 17, 0.06);
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.details-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16px;
  flex-wrap: wrap;
}

.details-title {
  font-size: 18px;
  font-weight: 600;
  margin: 0;
}

.details-subtitle {
  font-size: 13px;
  color: var(--muted);
  margin: 6px 0 0;
}

.details-actions {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

.details-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 12px;
}

.details-item {
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 12px 14px;
  display: flex;
  flex-direction: column;
  gap: 6px;
  background: var(--admin-surface);
}

.details-item.wide {
  grid-column: 1 / -1;
}

.details-label {
  font-size: 12px;
  color: var(--muted);
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.details-value {
  font-size: 14px;
  font-weight: 600;
}

.primary-btn {
  border: 1.5px solid #A51C49 !important;
  background: #A51C49 !important;
  color: #fff !important;
  padding: 12px 18px;
  border-radius: 12px;
  font-weight: 600;
  cursor: pointer;
  box-shadow: 0 6px 14px rgba(165, 28, 73, 0.12) !important;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  white-space: nowrap;
  transition: all 0.25s ease !important;
}

.primary-btn:hover {
  background: #851237 !important;
  border-color: #851237 !important;
  transform: translateY(-3px) !important;
  box-shadow: 0 8px 18px rgba(165, 28, 73, 0.25) !important;
}

.discount-list-page-container {
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding: 18px 20px;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  box-sizing: border-box;
}

.discount-table-wrapper {
  border: 1px solid var(--border);
  border-radius: var(--radius);
  background: var(--panel);
  box-shadow: 0 10px 26px rgba(16, 16, 16, 0.06);
  overflow: visible !important;
  max-width: 100%;
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
}

.discount-table {
  width: 100%;
  border-collapse: collapse;
  table-layout: auto;
}

.discount-table thead {
  background: var(--admin-primary) !important;
}

.discount-table th {
  background: var(--admin-primary) !important;
  text-align: center;
  padding: 12px 8px !important;
  font-size: 11px;
  letter-spacing: 0.02em !important;
  text-transform: uppercase;
  color: #ffffff !important;
  font-weight: 700;
  border-bottom: 1px solid #e2e8f0;
  white-space: nowrap;
  overflow: visible !important;
  text-overflow: unset !important;
}

.discount-table th:last-child,
.discount-table td:last-child {
  text-align: center;
}

.discount-table td {
  padding: 6px 5px;
  border-bottom: 1px solid var(--border);
  font-size: 11px;
  color: var(--text);
  vertical-align: middle;
  overflow: visible !important;
  white-space: nowrap;
  text-align: center;
}

.discount-table tbody tr:hover {
  background: var(--admin-soft);
}

.table-actions {
  display: flex;
  gap: 4px;
  flex-wrap: nowrap;
  align-items: center;
  justify-content: center;
}

.icon-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 26px;
  height: 26px;
  padding: 0;
  border-radius: 6px;
  box-shadow: none;
}

.ghost-btn.small.icon-btn,
.danger-btn.small.icon-btn {
  padding: 0;
}

.icon-btn svg {
  width: 12px;
  height: 12px;
}

.ghost-btn.icon-btn {
  background: var(--admin-soft);
  border-color: var(--admin-border);
}

.danger-btn.icon-btn {
  background: var(--admin-surface);
  border-color: var(--admin-danger);
}

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  border: 0;
}

.amount-cell {
  text-align: center;
  font-weight: 600;
  white-space: nowrap;
}

.remark-cell {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100px;
  color: var(--text);
}

/* 9 columns — clean proportional widths summing to 100% */
.discount-table th:nth-child(1),
.discount-table td:nth-child(1) {
  width: 5%;
  text-align: center;
}

/* Discount / Code (merged with type) */
.discount-table th:nth-child(2),
.discount-table td:nth-child(2) {
  width: 19%;
  min-width: 130px !important;
}

/* Value */
.discount-table th:nth-child(3),
.discount-table td:nth-child(3) {
  width: 8%;
  text-align: center;
  font-weight: 600;
}

/* Apply Rules */
.discount-table th:nth-child(4),
.discount-table td:nth-child(4) {
  width: 11%;
  min-width: 110px !important;
}

/* Min Booking */
.discount-table th:nth-child(5),
.discount-table td:nth-child(5) {
  width: 9%;
  min-width: 100px !important;
}

/* Validity */
.discount-table th:nth-child(6),
.discount-table td:nth-child(6) {
  width: 14%;
  min-width: 130px !important;
}

/* Status — overflow visible so pill badge never clips */
.discount-table th:nth-child(7),
.discount-table td:nth-child(7) {
  width: 10%;
  text-align: center;
  min-width: 90px !important;
}

/* Updated By */
.discount-table th:nth-child(8),
.discount-table td:nth-child(8) {
  width: 12%;
  min-width: 120px !important;
}

/* Actions */
.discount-table th:nth-child(9),
.discount-table td:nth-child(9) {
  width: 12%;
  text-align: center;
  overflow: visible !important;
  white-space: nowrap;
  min-width: 100px !important;
}

/* Status cell — never clip the pill badge */
.status-cell {
  overflow: visible !important;
  white-space: nowrap;
}


.empty-cell {
  text-align: center;
  color: var(--muted);
  padding: 24px 16px;
}

.id-chip {
  padding: 4px 8px;
  border-radius: 999px;
  border: 1px solid var(--border);
  font-weight: 600;
  font-size: 11px;
  white-space: nowrap;
  display: inline-block;
}

.discount-status-pill {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  border-radius: 999px;
  padding: 4px 10px;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  white-space: nowrap;
  border: 1px solid transparent;
}

.discount-status-pill.active {
  background: #ecfdf5;
  color: #10b981;
  border-color: rgba(16, 185, 129, 0.25);
}

.discount-status-pill.inactive {
  background: #fef2f2;
  color: #ef4444;
  border-color: rgba(239, 68, 68, 0.25);
}

.discount-status-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: currentColor;
  display: inline-block;
  flex-shrink: 0;
}

/* dot color inherits from pill */

@media (max-width: 1100px) {
  .toolbar {
    grid-template-columns: 1fr;
  }

  .toolbar-group {
    grid-template-columns: 1fr;
  }

  .toolbar-actions {
    justify-content: flex-start;
  }
}

/* ══════════════════════════════════════
   ACTIONS DROPDOWN STYLES
   ══════════════════════════════════════ */
.actions-dropdown-container {
  position: relative;
  display: inline-block;
}

.actions-trigger-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: #f8fafc;
  border: 1px solid #cbd5e1;
  color: #475569;
  padding: 5px 12px;
  border-radius: 6px;
  font-size: 11px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
  white-space: nowrap;
}

.actions-trigger-btn:hover,
.actions-trigger-btn.active {
  background: #f1f5f9;
  border-color: #94a3b8;
  color: #1e293b;
}

.actions-trigger-btn .chevron-icon {
  font-size: 8px;
  transition: transform 0.2s ease;
}

.actions-trigger-btn.active .chevron-icon {
  transform: rotate(180deg);
}

.actions-dropdown-menu {
  position: absolute;
  right: 0;
  margin-top: 4px;
  width: 150px;
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
  z-index: 50;
  overflow: hidden;
  animation: dropdownFadeIn 0.15s ease-out;
}

@keyframes dropdownFadeIn {
  from {
    opacity: 0;
    transform: translateY(-4px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.dropdown-item {
  display: flex;
  align-items: center;
  gap: 8px;
  width: 100%;
  padding: 8px 12px;
  border: none;
  background: transparent;
  font-size: 11px;
  font-weight: 600;
  text-align: left;
  cursor: pointer;
  color: #64748b;
  transition: all 0.15s ease;
}

.dropdown-item .item-icon {
  font-size: 11px;
  transition: color 0.15s ease;
}

/* Hover States with Curated Micro-Interactions */
.dropdown-item.view:hover {
  background: #eff6ff;
  color: #2563eb;
}

.dropdown-item.view:hover .item-icon {
  color: #2563eb;
}

.dropdown-item.edit:hover {
  background: #eff6ff;
  color: #2563eb;
}

.dropdown-item.edit:hover .item-icon {
  color: #2563eb;
}

.dropdown-item.delete:hover {
  background: #eff6ff;
  color: #2563eb;
}

.dropdown-item.delete:hover .item-icon {
  color: #2563eb;
}

/* ══════════════════════════════════════
   EXPORT BUTTON STYLE
   ══════════════════════════════════════ */
.export-btn {
  background: #A51C49 !important;
  border-color: #A51C49 !important;
  box-shadow: 0 4px 10px rgba(165, 28, 73, 0.2) !important;
  color: #ffffff !important;
  transition: all 0.25s ease !important;
}

.export-btn:hover {
  background: #851237 !important;
  border-color: #851237 !important;
  transform: translateY(-3px) !important;
}