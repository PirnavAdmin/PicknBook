/* ── Hotel Booking List ── */
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

.hbl-page {
  padding: 28px 32px;
  font-family: 'Inter', sans-serif;
  background: #f8fafc;
  min-height: 100%;
}

/* Header */
.hbl-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 24px;
}

.hbl-title {
  font-size: 22px;
  font-weight: 700;
  color: #0f172a;
  letter-spacing: -0.4px;
  margin: 0 0 4px;
}

.hbl-subtitle {
  font-size: 13px;
  color: #64748b;
  margin: 0;
}

/* Stats */
.hbl-stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
  margin-bottom: 24px;
}

.hbl-stat-card {
  background: #fff;
  border-radius: 12px;
  padding: 18px 20px;
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05), 0 0 0 1px rgba(0, 0, 0, 0.04);
  display: flex;
  flex-direction: column;
  gap: 6px;
  border-left: 6px solid #cbd5e1;
}

.hbl-stat-card:nth-child(1) {
  border-left-color: #7c3aed !important;
  background: linear-gradient(to right, #ffffff, #f5f0ff) !important;
  box-shadow: inset 0 0 12px rgba(124, 58, 237, 0.04), 0 4px 10px rgba(0, 0, 0, 0.05) !important;
}
.hbl-stat-card.hbl-stat-green {
  border-left-color: #10b981 !important;
  background: linear-gradient(to right, #ffffff, #e6fcf0) !important;
  box-shadow: inset 0 0 12px rgba(16, 185, 129, 0.04), 0 4px 10px rgba(0, 0, 0, 0.05) !important;
}
.hbl-stat-card.hbl-stat-orange {
  border-left-color: #f97316 !important;
  background: linear-gradient(to right, #ffffff, #fff3e6) !important;
  box-shadow: inset 0 0 12px rgba(249, 115, 22, 0.04), 0 4px 10px rgba(0, 0, 0, 0.05) !important;
}
.hbl-stat-card.hbl-stat-blue {
  border-left-color: #3b82f6 !important;
  background: linear-gradient(to right, #ffffff, #e6f0ff) !important;
  box-shadow: inset 0 0 12px rgba(59, 130, 246, 0.04), 0 4px 10px rgba(0, 0, 0, 0.05) !important;
}

.hbl-stat-label {
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.7px;
  color: #64748b;
}

.hbl-stat-value {
  font-size: 22px;
  font-weight: 700;
  color: #0f172a;
  letter-spacing: -0.5px;
}

/* Filters */
.hbl-filters {
  display: flex;
  align-items: flex-end;
  gap: 20px; /* Gives space between the two inputs */
  margin-bottom: 20px;
  flex-wrap: nowrap !important;
  width: 100%;
}

.hbl-filter-group {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.hbl-filter-group.search {
  width: 420px; /* Increased search input width */
}

.hbl-filter-group.select {
  width: 260px; /* Increased status select width */
}

.hbl-filter-group.action {
  flex: 0 0 auto;
}

.hbl-filter-label {
  font-size: 11.5px;
  font-weight: 700 !important; /* Thick font weight */
  color: #334155 !important; /* Darker tone for visibility */
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.hbl-search-wrap {
  width: 100%;
  position: relative;
  display: flex;
  align-items: center;
}

.hbl-search-wrap svg {
  position: absolute;
  left: 12px;
  color: #94a3b8;
}

.hbl-search {
  width: 100%;
  padding: 8px 12px 8px 36px; /* Decreased height padding */
  border: 1.5px solid #cbd5e1 !important; /* Changed to Light color */
  border-radius: 9px;
  font-size: 13px;
  font-family: inherit;
  background: #fff;
  color: #0f172a;
  outline: none;
  transition: all 0.2s ease;
}

.hbl-search:focus {
  border-color: #A51C49 !important;
  box-shadow: 0 0 0 3px rgba(194, 24, 91, 0.15) !important;
}

.hbl-select {
  width: 100%;
  padding: 8px 12px; /* Decreased height padding */
  border: 1.5px solid #cbd5e1 !important; /* Changed to Light color */
  border-radius: 9px;
  font-size: 13px;
  font-family: inherit;
  background: #fff;
  color: #374151;
  outline: none;
  cursor: pointer;
  transition: all 0.2s ease;
}

.hbl-select:focus {
  border-color: #A51C49 !important;
  box-shadow: 0 0 0 3px rgba(194, 24, 91, 0.15) !important;
}

.hbl-pg-btn.export-btn {
  border: 1.5px solid #1e75ff !important;
  background: #1e75ff !important;
  color: #ffffff !important;
  padding: 8px 18px; /* Decreased height padding */
  border-radius: 9px;
  font-weight: 600;
  font-size: 13px;
  box-shadow: 0 4px 10px rgba(30, 117, 255, 0.15);
}

.hbl-pg-btn.export-btn:hover:not(:disabled) {
  background: #0052d9 !important;
  border-color: #0052d9 !important;
  transform: translateY(-2px);
}

/* Table */
.hbl-table-wrap {
  background: #fff;
  border-radius: 12px;
  box-shadow: 0 1px 3px rgba(15,23,42,0.06), 0 0 0 1px rgba(15,23,42,0.05);
  overflow-x: auto;
}

.hbl-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 13.5px;
}

.hbl-table thead tr {
  background: #A51C49 !important;
  border-bottom: 1.5px solid #A51C49 !important;
}

.hbl-table th {
  padding: 12px 16px;
  text-align: center !important;
  font-size: 11px;
  font-weight: 700;
  color: #ffffff !important;
  text-transform: uppercase;
  letter-spacing: 0.6px;
  color: #64748b;
  white-space: nowrap;
}

.hbl-table td {
  padding: 13px 16px;
  border-bottom: 1px solid #f1f5f9;
  color: #1e293b;
  white-space: nowrap;
  text-align: center !important;
}

.hbl-table tbody tr:last-child td { border-bottom: none; }

.hbl-table tbody tr:hover { background: #fafbff; }

.hbl-id {
  font-family: 'Courier New', monospace;
  font-weight: 600;
  color: #3b82f6 !important;
  font-size: 12.5px;
}

.hbl-amount {
  font-weight: 600;
  color: #0f172a !important;
}

.hbl-empty {
  text-align: center;
  padding: 48px !important;
  color: #94a3b8;
  font-size: 14px;
}

/* Badges */
.hbl-badge {
  display: inline-block;
  padding: 3px 10px;
  border-radius: 100px;
  font-size: 11.5px;
  font-weight: 600;
  letter-spacing: 0.2px;
}

.hbl-badge-success  { background: #dcfce7; color: #15803d; }
.hbl-badge-pending  { background: #fef9c3; color: #a16207; }
.hbl-badge-cancelled { background: #fee2e2; color: #b91c1c; }

/* Pagination */
.hbl-pagination {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16px;
  margin-top: 20px;
}

.hbl-pg-btn {
  padding: 8px 18px;
  border: 1.5px solid #e2e8f0;
  border-radius: 8px;
  background: #fff;
  font-size: 13px;
  font-family: inherit;
  font-weight: 500;
  color: #374151;
  cursor: pointer;
  transition: all 0.18s;
}

.hbl-pg-btn:hover:not(:disabled) {
  border-color: #3b82f6;
  color: #3b82f6;
}

.hbl-pg-btn:disabled { opacity: 0.4; cursor: not-allowed; }

.hbl-pg-info {
  font-size: 13px;
  color: #64748b;
  font-weight: 500;
}

@media (max-width: 900px) {
  .hbl-page { padding: 20px 16px; }
  .hbl-stats { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 480px) {
  .hbl-stats { grid-template-columns: 1fr; }
}

