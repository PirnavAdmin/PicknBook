.discount-heading {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.discount-heading-main {
  margin: 0;
  font-size: 26px;
  font-weight: 700;
  color: var(--admin-primary);
  letter-spacing: 0.02em;
}

.discount-heading-sub {
  margin: 0;
  font-size: 18px;
  font-weight: 700;
  color: var(--admin-muted);
}

.stats-row {
  display: flex;
  gap: 16px;
  align-items: stretch;
  flex-wrap: wrap;
}

.stat-card {
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 12px 16px;
  background: var(--panel);
  box-shadow: 0 8px 20px rgba(15, 23, 42, 0.08);
  flex: 1;
  min-width: 180px;
  max-width: 260px;
  text-align: center;
  transition: all 0.25s ease;
}

.stat-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 24px rgba(15, 23, 42, 0.12);
}

.stat-label {
  font-size: 13px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.stat-card.total {
  border-left: 4px solid #2563eb !important;
}
.stat-card.total .stat-label {
  color: #2563eb !important;
}
.stat-card.total .stat-value {
  color: #1e40af !important;
}

.stat-card.active {
  border-left: 4px solid #10b981 !important;
}
.stat-card.active .stat-label {
  color: #10b981 !important;
}
.stat-card.active .stat-value {
  color: #047857 !important;
}

.stat-card.inactive {
  border-left: 4px solid #ef4444 !important;
}
.stat-card.inactive .stat-label {
  color: #ef4444 !important;
}
.stat-card.inactive .stat-value {
  color: #b91c1c !important;
}

.stat-value {
  font-size: 28px;
  font-weight: 700;
  margin: 8px 0;
}

.stat-meta {
  font-size: 12px;
  color: var(--muted);
}

.toolbar {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 16px;
  flex-wrap: wrap;
}

.toolbar-group {
  display: flex;
  gap: 16px;
  align-items: flex-end;
  flex-wrap: wrap;
}

.toolbar-actions {
  display: flex;
  gap: 10px;
  align-items: flex-end;
  justify-content: flex-end;
  flex-wrap: wrap;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 6px;
  font-size: 12px;
  color: var(--muted);
}

.field span {
  font-weight: 700;
  text-transform: uppercase;
  font-size: 10px;
  letter-spacing: 0.05em;
  color: #000000 !important;
}

.field input,
.field select {
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 6px 12px;
  font-size: 13px;
  color: var(--text);
  background: var(--admin-surface);
  min-width: 180px;
  height: 38px;
  box-sizing: border-box;
  width: 100%;
  transition: border-color 0.2s ease;
}

.field input:focus,
.field select:focus,
.field input:hover,
.field select:hover {
  border-color: #ef4444 !important;
  outline: none;
}

.field input[type="text"] {
  min-width: 320px;
}

.field.wide {
  grid-column: 1 / -1;
}

.add-panel {
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 18px 20px;
  background: var(--panel);
  box-shadow: 0 10px 24px rgba(15, 23, 42, 0.08);
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.add-panel-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16px;
  flex-wrap: wrap;
}

.add-panel-title {
  font-size: 18px;
  font-weight: 600;
  margin: 0;
}

.add-panel-subtitle {
  font-size: 13px;
  color: var(--muted);
  margin: 6px 0 0;
}

.add-form {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 14px;
  align-items: end;
}

.form-actions {
  display: flex;
  gap: 10px;
  justify-content: flex-end;
  align-items: center;
  grid-column: 1 / -1;
}

.details-panel {
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 18px 20px;
  background: var(--panel);
  box-shadow: 0 12px 28px rgba(17, 17, 17, 0.06);
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.details-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16px;
  flex-wrap: wrap;
}

.details-title {
  font-size: 18px;
  font-weight: 600;
  margin: 0;
}

.details-subtitle {
  font-size: 13px;
  color: var(--muted);
  margin: 6px 0 0;
}

.details-actions {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

.details-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 12px;
}

.details-item {
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 12px 14px;
  display: flex;
  flex-direction: column;
  gap: 6px;
  background: var(--admin-surface);
}

.details-item.wide {
  grid-column: 1 / -1;
}

.details-label {
  font-size: 12px;
  color: var(--muted);
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.details-value {
  font-size: 14px;
  font-weight: 600;
}

.primary-btn {
  border: 1px solid var(--admin-primary);
  background: var(--admin-primary);
  color: #fff;
  padding: 0 18px;
  height: 38px;
  border-radius: 8px;
  font-weight: 600;
  cursor: pointer;
  box-shadow: 0 6px 14px rgba(15, 23, 42, 0.12);
  display: inline-flex;
  align-items: center;
  gap: 8px;
  white-space: nowrap;
  box-sizing: border-box;
}

.primary-btn:hover {
  background: var(--admin-primary-strong);
  border-color: var(--admin-primary-strong);
}

.discount-list-page-container {
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding: 18px 20px;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  box-sizing: border-box;
}

.discount-table-wrapper {
  border: 1px solid var(--border);
  border-radius: var(--radius);
  background: var(--panel);
  box-shadow: 0 10px 26px rgba(16, 16, 16, 0.06);
  overflow: hidden;
  max-width: 100%;
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
}

.discount-table {
  width: 100%;
  border-collapse: collapse;
  table-layout: fixed;
}

.discount-table thead {
  background: #be185d !important;
}

.discount-table th {
  background: #be185d !important;
  text-align: center;
  padding: 12px 14px;
  font-size: 11px;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: #ffffff !important;
  font-weight: 700;
  border-bottom: 1px solid #e2e8f0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.discount-table th:last-child,
.discount-table td:last-child {
  text-align: center;
}

.discount-table td {
  padding: 6px 5px;
  border-bottom: 1px solid var(--border);
  font-size: 11px;
  color: var(--text);
  vertical-align: middle;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: center;
}

.discount-table tbody tr:hover {
  background: var(--admin-soft);
}

.table-actions {
  display: flex;
  gap: 8px;
  flex-wrap: nowrap;
  align-items: center;
  justify-content: center;
}

.icon-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 34px;
  height: 34px;
  padding: 0;
  border-radius: 10px;
  box-shadow: none;
}

.ghost-btn.small.icon-btn,
.danger-btn.small.icon-btn {
  padding: 0;
}

.icon-btn svg {
  width: 14px;
  height: 14px;
}

.ghost-btn.icon-btn {
  background: var(--admin-soft);
  border-color: var(--admin-border);
}

.danger-btn.icon-btn {
  background: var(--admin-surface);
  border-color: var(--admin-danger);
}

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  border: 0;
}

.amount-cell {
  text-align: center;
  font-weight: 600;
  white-space: nowrap;
}

.discount-table td.remark-cell {
  white-space: normal !important;
  word-break: break-word !important;
  text-align: center;
  vertical-align: middle;
  max-width: 150px;
  color: var(--text);
  overflow: visible !important;
  text-overflow: clip !important;
}

/* All 9 columns sum to 100% — no scroll, everything fits on screen */
.discount-table th:nth-child(1),
.discount-table td:nth-child(1) {
  width: 6%;
}

.discount-table th:nth-child(2),
.discount-table td:nth-child(2) {
  width: 10%;
}

.discount-table th:nth-child(3),
.discount-table td:nth-child(3) {
  width: 9%;
  text-align: center;
  font-weight: 600;
}

.discount-table th:nth-child(4),
.discount-table td:nth-child(4) {
  width: 9%;
  text-align: center;
}

/* Entry Date column */
.discount-table th:nth-child(5),
.discount-table td:nth-child(5) {
  width: 14%;
  padding-left: 8px;
}

.discount-table th:nth-child(6),
.discount-table td:nth-child(6) {
  width: 14%;
}

.discount-table th:nth-child(7),
.discount-table td:nth-child(7) {
  width: 10%;
}

.discount-table th:nth-child(8),
.discount-table td:nth-child(8) {
  width: 18%;
}

.discount-table th:nth-child(9),
.discount-table td:nth-child(9) {
  width: 10%;
  text-align: center;
  overflow: visible !important;
  white-space: nowrap;
}

/* Status cell — never clip the pill badge */
.status-cell {
  overflow: visible !important;
  white-space: nowrap;
}

.empty-cell {
  text-align: center;
  color: var(--muted);
  padding: 24px 16px;
}

.id-chip {
  padding: 6px 12px;
  border-radius: 999px;
  border: 1px solid var(--border);
  font-weight: 600;
  font-size: 13px;
  white-space: nowrap;
}

.discount-status-pill {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  border-radius: 999px;
  padding: 4px 10px;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  white-space: nowrap;
  border: 1px solid transparent;
}

.discount-status-pill.active {
  background: #ecfdf5;
  color: #10b981;
  border-color: rgba(16, 185, 129, 0.25);
}

.discount-status-pill.inactive {
  background: #fef2f2;
  color: #ef4444;
  border-color: rgba(239, 68, 68, 0.25);
}

.discount-status-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: currentColor;
  display: inline-block;
  flex-shrink: 0;
}

/* dot color inherits from pill */

@media (max-width: 1100px) {
  .toolbar-actions {
    justify-content: flex-start;
  }
}

/* ══════════════════════════════════════
   ACTIONS DROPDOWN STYLES
   ══════════════════════════════════════ */
.actions-dropdown-container {
  position: relative;
  display: inline-block;
}

.actions-trigger-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: #f8fafc;
  border: 1px solid #cbd5e1;
  color: #475569;
  padding: 5px 12px;
  border-radius: 6px;
  font-size: 11px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
  white-space: nowrap;
}

.actions-trigger-btn:hover,
.actions-trigger-btn.active {
  background: #f1f5f9;
  border-color: #94a3b8;
  color: #1e293b;
}

.actions-trigger-btn .chevron-icon {
  font-size: 8px;
  transition: transform 0.2s ease;
}

.actions-trigger-btn.active .chevron-icon {
  transform: rotate(180deg);
}

.actions-dropdown-menu {
  position: absolute;
  right: 0;
  margin-top: 4px;
  width: 150px;
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
  z-index: 50;
  overflow: hidden;
  animation: dropdownFadeIn 0.15s ease-out;
}

@keyframes dropdownFadeIn {
  from {
    opacity: 0;
    transform: translateY(-4px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.dropdown-item {
  display: flex;
  align-items: center;
  gap: 8px;
  width: 100%;
  padding: 8px 12px;
  border: none;
  background: transparent !important;
  font-size: 11px;
  font-weight: 600;
  text-align: left;
  cursor: pointer;
  color: #64748b !important;
  transition: all 0.15s ease;
}

.dropdown-item.delete {
  background: transparent !important;
  color: #64748b !important;
}

.dropdown-item .item-icon {
  font-size: 11px;
  transition: color 0.15s ease;
}

/* Hover States with Curated Micro-Interactions */
.dropdown-item.view:hover,
.dropdown-item.edit:hover,
.dropdown-item.delete:hover {
  background: #fef2f2 !important;
  color: #dc2626 !important;
}
.dropdown-item.view:hover .item-icon,
.dropdown-item.edit:hover .item-icon,
.dropdown-item.delete:hover .item-icon {
  color: #dc2626 !important;
}

/* ══════════════════════════════════════
   EXPORT BUTTON STYLE
   ══════════════════════════════════════ */
.export-btn {
  background: #2563eb !important;
  border-color: #2563eb !important;
  box-shadow: 0 4px 10px rgba(37, 99, 235, 0.2) !important;
  color: #ffffff !important;
}

.export-btn:hover {
  background: #1d4ed8 !important;
  border-color: #1d4ed8 !important;
}

/* ══════════════════════════════════════
   CUSTOM DROPDOWN (STATUS)
   ══════════════════════════════════════ */
.custom-dropdown-container {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.custom-dropdown-trigger {
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 6px 12px;
  font-size: 13px;
  color: var(--text);
  background: var(--admin-surface);
  min-width: 180px;
  height: 38px;
  box-sizing: border-box;
  width: 100%;
  display: inline-flex;
  align-items: center;
  justify-content: space-between;
  cursor: pointer;
  font-weight: normal;
  transition: border-color 0.2s ease;
}

.custom-dropdown-trigger:hover,
.custom-dropdown-trigger:focus {
  border-color: #ef4444 !important;
  outline: none;
}

.custom-dropdown-trigger .chevron-icon {
  font-size: 10px;
  color: var(--muted);
  transition: transform 0.2s ease;
}

.custom-dropdown-trigger .chevron-icon.open {
  transform: rotate(180deg);
}

.custom-dropdown-menu {
  position: absolute;
  top: 100%;
  left: 0;
  margin-top: 4px;
  width: 100%;
  min-width: 180px;
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
  z-index: 60;
  overflow: hidden;
}

.custom-dropdown-item {
  display: block;
  width: 100%;
  padding: 8px 12px;
  border: none;
  background: transparent !important;
  font-size: 13px;
  text-align: left;
  cursor: pointer;
  color: #334155 !important;
  transition: all 0.15s ease;
  box-sizing: border-box;
}

.custom-dropdown-item:hover,
.custom-dropdown-item.active {
  background: #fef2f2 !important;
  color: #dc2626 !important;
}
