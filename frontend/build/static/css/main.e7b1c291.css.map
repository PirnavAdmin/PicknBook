/* ══════════════════════════════════════════════════════════
   SIDEBAR  —  dark + light theme, full text display
   ══════════════════════════════════════════════════════════ */

/* ── Container — fixed overlay, hidden by default ── */
.ds-sidebar {
  width: 252px;
  min-width: 252px;
  max-width: 252px;
  height: 100vh;
  background: #12151f;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  flex-shrink: 0;

  /* Fixed overlay — slides in from left */
  position: fixed;
  top: 0;
  left: 0;
  z-index: 1100;
  transform: translateX(-100%);
  transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1),
              box-shadow 0.28s ease;
  box-shadow: none;
}

/* Open state — slide in */
.ds-sidebar.ds-sidebar-open {
  transform: translateX(0);
  box-shadow: 6px 0 32px rgba(0, 0, 0, 0.35);
}

/* ══════════════════════════
   LIGHT THEME — white sidebar
   ══════════════════════════ */
.admin-shell:not(.dark-theme) .ds-sidebar {
  background: #ffffff;
  border-right: 1px solid #e2e8f0;
  box-shadow: 2px 0 12px rgba(15, 23, 42, 0.06);
}

/* ── Header / Brand ── */
.ds-sidebar-header {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 16px 14px 14px;
  flex-shrink: 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.07);
}

.admin-shell:not(.dark-theme) .ds-sidebar-header {
  border-bottom: 1px solid #e2e8f0;
}

.ds-brand-icon {
  width: 34px;
  height: 34px;
  border-radius: 8px;
  background: #a51c49;
  display: grid;
  place-items: center;
  flex-shrink: 0;
  box-shadow: 0 4px 12px rgba(229, 57, 53, 0.35);
}

.ds-brand-name {
  font-size: 0.78rem;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  white-space: nowrap;
}

.admin-shell:not(.dark-theme) .ds-brand-name {
  color: #1e293b;
}

/* ── Search ── */
.ds-search-wrap {
  position: relative;
  padding: 10px 12px 8px;
  flex-shrink: 0;
}

.ds-search-ico {
  position: absolute;
  left: 22px;
  top: 50%;
  transform: translateY(-50%);
  color: #64748b;
  pointer-events: none;
}

.ds-search-input {
  width: 100%;
  height: 32px;
  padding: 0 10px 0 30px;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 8px;
  color: #cbd5e1;
  font-size: 0.78rem;
  font-family: inherit;
  outline: none;
  box-sizing: border-box;
  transition: border-color 0.2s ease, background 0.2s ease;
}

.admin-shell:not(.dark-theme) .ds-search-input {
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  color: #1e293b;
}

.ds-search-input::placeholder { color: #64748b; }
.ds-search-input:focus { border-color: rgba(229, 57, 53, 0.5); }

.admin-shell:not(.dark-theme) .ds-search-input::placeholder { color: #94a3b8; }
.admin-shell:not(.dark-theme) .ds-search-input:focus {
  border-color: #a51c49;
  background: #fff;
  box-shadow: 0 0 0 3px rgba(229, 57, 53, 0.08);
}

/* ── Nav scroll area ── */
.ds-nav {
  flex: 1;
  overflow-y: auto;
  overflow-x: hidden;
  padding: 4px 0 24px;
  scrollbar-width: thin;
  scrollbar-color: rgba(255, 255, 255, 0.12) transparent;
}

.admin-shell:not(.dark-theme) .ds-nav {
  scrollbar-color: rgba(0, 0, 0, 0.1) transparent;
}

.ds-nav::-webkit-scrollbar { width: 4px; }
.ds-nav::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, 0.12);
  border-radius: 99px;
}

.admin-shell:not(.dark-theme) .ds-nav::-webkit-scrollbar-thumb {
  background: rgba(0, 0, 0, 0.1);
}

/* ── Group ── */
.ds-group {
  margin-bottom: 2px;
}

/* ── Section label ── */
.ds-section-label {
  margin: 16px 14px 5px;
  font-size: 0.62rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #3d4f6b;
}

.admin-shell:not(.dark-theme) .ds-section-label {
  color: #94a3b8;
}

/* ── Item wrapper ── */
.ds-item-wrap {
  display: flex;
  flex-direction: column;
}

/* ── Nav row (parent item) ── */
.ds-nav-row {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 9px 14px;
  color: #7d8ba3;
  text-decoration: none;
  font-size: 0.83rem;
  font-weight: 500;
  cursor: pointer;
  background: none;
  border: none;
  width: 100%;
  text-align: left;
  font-family: inherit;
  transition: color 0.18s ease, background 0.18s ease;
  position: relative;
  line-height: 1.3;
  box-sizing: border-box;
}

/* Light theme parent row */
.admin-shell:not(.dark-theme) .ds-nav-row {
  color: #475569;
}

.ds-nav-row:hover {
  color: #e2e8f0;
  background: rgba(255, 255, 255, 0.05);
}

.admin-shell:not(.dark-theme) .ds-nav-row:hover {
  color: #1e293b;
  background: #f1f5f9;
}

/* Active parent — dark */
.ds-nav-row.ds-active {
  color: #a51c49;
  background: rgba(229, 57, 53, 0.1);
  font-weight: 600;
}

/* Active parent — light */
.admin-shell:not(.dark-theme) .ds-nav-row.ds-active {
  color: #a51c49;
  background: rgba(229, 57, 53, 0.07);
}

.ds-nav-row.ds-active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 8px;
  bottom: 8px;
  width: 3px;
  border-radius: 0 3px 3px 0;
  background: #a51c49;
}

/* ── Icon box ── */
.ds-nav-icon {
  width: 18px;
  height: 18px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: inherit;
}

/* Active icon: red box */
.ds-icon-active {
  width: 28px;
  height: 28px;
  border-radius: 7px;
  background: #a51c49;
  color: #ffffff !important;
  box-shadow: 0 3px 8px rgba(229, 57, 53, 0.35);
  flex-shrink: 0;
}

/* ── Label — FULL text, no truncation ── */
.ds-nav-label {
  flex: 1;
  white-space: normal;       /* allow wrap */
  word-break: break-word;
  line-height: 1.35;
  min-width: 0;
}

/* ── Chevron ── */
.ds-chevron {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  color: #3d4f6b;
  transition: transform 0.25s ease;
  align-self: flex-start;
  margin-top: 3px;
}

.admin-shell:not(.dark-theme) .ds-chevron {
  color: #94a3b8;
}

.ds-chevron-open {
  transform: rotate(180deg);
}

/* ── Submenu container ── */
.ds-submenu {
  overflow: hidden;
  max-height: 0;
  transition: max-height 0.35s cubic-bezier(0.4, 0, 0.2, 1);
}

.ds-submenu-open {
  max-height: 2400px;
}

/* ── Submenu background tint ── */
.ds-submenu {
  background: rgba(0, 0, 0, 0.12);
}

.admin-shell:not(.dark-theme) .ds-submenu {
  background: #f8fafc;
  border-left: 2px solid #e2e8f0;
  margin-left: 22px;
}

/* ── Sub item ── */
.ds-sub-row {
  display: flex;
  align-items: flex-start;
  gap: 9px;
  padding: 7px 14px 7px 38px;
  color: #5a6a82;
  text-decoration: none;
  font-size: 0.79rem;
  font-weight: 400;
  cursor: pointer;
  transition: color 0.18s ease, background 0.18s ease;
  line-height: 1.35;
}

.admin-shell:not(.dark-theme) .ds-sub-row {
  padding: 7px 14px 7px 14px;
  color: #64748b;
}

.ds-sub-row:hover {
  color: #e2e8f0;
  background: rgba(255, 255, 255, 0.04);
}

.admin-shell:not(.dark-theme) .ds-sub-row:hover {
  color: #1e293b;
  background: #eef2f6;
}

.ds-sub-row.ds-sub-active {
  color: #a51c49;
  font-weight: 600;
}

.admin-shell:not(.dark-theme) .ds-sub-row.ds-sub-active {
  color: #a51c49;
  background: rgba(229, 57, 53, 0.06);
}

/* ── Sub dot ── */
.ds-sub-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  border: 1.5px solid currentColor;
  flex-shrink: 0;
  margin-top: 4px;
  opacity: 0.55;
}

.ds-sub-active .ds-sub-dot {
  background: #a51c49;
  border-color: #a51c49;
  opacity: 1;
}

/* ── Backdrop — covers full screen, click to close sidebar ── */
.ds-backdrop {
  position: fixed;
  inset: 0;
  z-index: 1099;
  background: rgba(0, 0, 0, 0.45);
  backdrop-filter: blur(1px);
  cursor: pointer;
  animation: ds-backdrop-in 0.22s ease forwards;
}

@keyframes ds-backdrop-in {
  from { opacity: 0; }
  to   { opacity: 1; }
}

/* Light theme backdrop */
.admin-shell:not(.dark-theme) .ds-backdrop {
  background: rgba(15, 23, 42, 0.3);
}

/* ── Light theme sidebar border ── */
.admin-shell:not(.dark-theme) .ds-sidebar.ds-sidebar-open {
  box-shadow: 6px 0 32px rgba(15, 23, 42, 0.18);
}

/* ── PickNBook cursor hint ── */
.picknbook-toggle {
  cursor: pointer;
  user-select: none;
}

/* ── Dark theme active overrides to blue ── */
.admin-shell.dark-theme .ds-brand-icon {
  background: #2563eb !important;
  box-shadow: 0 4px 12px rgba(37, 99, 235, 0.35) !important;
}

.admin-shell.dark-theme .ds-nav-row.ds-active {
  color: #3b82f6 !important;
  background: rgba(37, 99, 235, 0.1) !important;
}

.admin-shell.dark-theme .ds-nav-row.ds-active::before {
  background: #2563eb !important;
}

.admin-shell.dark-theme .ds-icon-active {
  background: #2563eb !important;
  box-shadow: 0 3px 8px rgba(37, 99, 235, 0.35) !important;
}

.admin-shell.dark-theme .ds-sub-row.ds-sub-active {
  color: #3b82f6 !important;
}

.admin-shell.dark-theme .ds-sub-active .ds-sub-dot {
  background: #2563eb !important;
  border-color: #2563eb !important;
}

