/* ── Clean Travel Animation Theme – Flat UI (Screenshot Match) ── */
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap');

/* ── Reset ── */
.login-wrapper *,
.login-wrapper *::before,
.login-wrapper *::after {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

/* ── Wrapper: Original Sky Gradient ── */
.login-wrapper {
  height: 100vh;
  width: 100vw;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: 'Inter', sans-serif;
  overflow: hidden;
  position: fixed;
  top: 0;
  left: 0;
  background: linear-gradient(135deg, #f8fafc 0%, #eff6ff 100%);
  isolation: isolate;
}

/* ── Unified Skyline Vector Background ── */
.skyline-background {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 60vh;
  z-index: 1;
  pointer-events: none;
  opacity: 0.85;
  background-image: url('../../../assets/images/illustrations/travel-skyline-bg-2.png');
  background-size: cover;
  background-position: center bottom;
  background-repeat: no-repeat;
}

.skyline-background svg {
  width: 100%;
  height: 100%;
}

/* Original blue/indigo outlines overrides for monuments */
.login-wrapper .lm {
  stroke: #4fa8e8 !important;
}

.login-wrapper .lm-thin {
  stroke: #c7d2fe !important;
}

.login-wrapper .lm-dot:not(.admin-flight-path):not(.admin-flight-path-2) {
  stroke: #c7d2fe !important;
}

/* Skyline Vector Animations */
@keyframes adminPlaneFly {
  0% {
    transform: translate(-100px, 50px) rotate(-6deg) scale(0.85);
    opacity: 0;
  }

  5% {
    opacity: 1;
  }

  50% {
    transform: translate(650px, -40px) rotate(-3deg) scale(1);
  }

  95% {
    opacity: 1;
  }

  100% {
    transform: translate(1350px, -10px) rotate(2deg) scale(1.15);
    opacity: 0;
  }
}

.admin-plane-fly {
  animation: adminPlaneFly 18s cubic-bezier(0.25, 0.46, 0.45, 0.94) infinite;
  transform-origin: center;
}

.admin-plane-fly path {
  fill: #ef4444 !important;
  stroke: #ef4444 !important;
}

@keyframes adminDashMove {
  0% {
    stroke-dashoffset: 0;
    stroke: #ef4444;
  }

  50% {
    stroke: #dc2626;
    filter: drop-shadow(0 0 2px rgba(239, 68, 68, 0.5));
  }

  100% {
    stroke-dashoffset: -120;
    stroke: #ef4444;
  }
}

.admin-flight-path {
  stroke-dasharray: 8 6;
  animation: adminDashMove 3s linear infinite !important;
}

.admin-flight-path-2 {
  stroke-dasharray: 8 6;
  animation: adminDashMove 4s linear infinite !important;
}

@keyframes adminBalloon1 {

  0%,
  100% {
    transform: translate(170px, 240px) scale(1);
  }

  50% {
    transform: translate(175px, 215px) scale(1.05);
  }
}

.admin-balloon-1 {
  animation: adminBalloon1 12s ease-in-out infinite;
  transform-origin: center;
}

@keyframes adminBalloon2 {

  0%,
  100% {
    transform: translate(1220px, 200px) scale(1);
  }

  50% {
    transform: translate(1215px, 180px) scale(0.95);
  }
}

.admin-balloon-2 {
  animation: adminBalloon2 15s ease-in-out infinite;
  transform-origin: center;
}

@keyframes adminCloudDrift {
  0% {
    transform: translateX(0px);
  }

  100% {
    transform: translateX(25px);
  }
}

.admin-cloud-1 {
  animation: adminCloudDrift 20s ease-in-out infinite alternate;
}

.admin-cloud-2 {
  animation: adminCloudDrift 24s ease-in-out infinite alternate-reverse;
}

.admin-cloud-3 {
  animation: adminCloudDrift 18s ease-in-out infinite alternate;
}

/* ── Main Layout Container ── */
.login-content-container {
  display: flex;
  width: 100%;
  max-width: 1200px;
  height: 100vh;
  margin: 0 auto;
  position: relative;
  z-index: 2;
  align-items: center;
  justify-content: space-between;
  padding: 0 40px;
}

/* ── Left Side: Brand Panel ── */
.left-side {
  flex: 1.25;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  max-width: 580px;
  padding-right: 40px;
  padding-top: 85px;
  /* Spaced to clear logo */
}

.badge-pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: #eff6ff;
  border: 1px solid #bfdbfe;
  color: #1e40af;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.5px;
  padding: 6px 14px;
  border-radius: 100px;
  margin-bottom: 16px;
  text-transform: uppercase;
}

.badge-pill .dot {
  width: 6px;
  height: 6px;
  background-color: #3b82f6;
  border-radius: 50%;
}

.heading {
  font-size: 42px;
  font-weight: 800;
  color: #0f172a;
  line-height: 1.2;
  margin-bottom: 12px;
  letter-spacing: -1px;
}

.description {
  font-size: 16px;
  color: #475569;
  line-height: 1.6;
  margin-bottom: 16px;
  max-width: 480px;
}

.red-divider {
  width: 48px;
  height: 4px;
  background-color: #ef4444;
  border-radius: 2px;
}

/* Features Grid */
.features-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  margin-top: 24px;
}

.features-grid .feature-item {
  display: flex;
  flex-direction: column;
  gap: 12px;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border: 1px solid rgba(255, 255, 255, 0.7);
  border-radius: 16px;
  padding: 16px;
  box-shadow: 0 4px 20px rgba(15, 23, 42, 0.02);
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.features-grid .feature-item:hover {
  transform: translateY(-2px);
  background: #ffffff;
  box-shadow: 0 8px 30px rgba(15, 23, 42, 0.05);
}

.feature-icon-wrapper {
  width: 40px;
  height: 40px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.blue-icon {
  background-color: #eff6ff;
  color: #3b82f6;
}

.purple-icon {
  background-color: #faf5ff;
  color: #a855f7;
}

.green-icon {
  background-color: #f0fdf4;
  color: #22c55e;
}

.feature-text h3 {
  font-size: 13px;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 4px;
}

.feature-text p {
  font-size: 12px;
  color: #64748b;
  line-height: 1.4;
}

/* ── Right Side: Form Panel ── */
.right-side {
  flex: 0.9;
  display: flex;
  justify-content: flex-end;
  align-items: center;
}

/* ── Login Box: Matches reference screenshot exactly ── */
.login-box {
  width: 100%;
  max-width: 360px;
  background: #ffffff;
  /* Solid White Card */
  border: 1px solid rgba(15, 23, 42, 0.05);
  border-radius: 20px;
  padding: 20px 24px;
  box-shadow: 0 25px 50px -12px rgba(15, 23, 42, 0.08);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.login-box:hover {
  transform: translateY(-5px);
  box-shadow: 0 35px 60px -15px rgba(15, 23, 42, 0.12);
  border-color: rgba(59, 130, 246, 0.2);
}

.login-box .title {
  font-size: 24px;
  font-weight: 800;
  color: #0f172a;
  margin-bottom: 6px;
  text-align: center;
}

.login-box .subtitle {
  font-size: 12.5px;
  color: #64748b;
  margin-bottom: 12px;
  text-align: center;
}

.form-group {
  margin-bottom: 12px;
  display: flex;
  flex-direction: column;
}

.form-group label {
  font-size: 11px;
  font-weight: 700;
  color: #475569;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  margin-bottom: 6px;
}

.input-with-icon {
  position: relative;
  display: flex;
  align-items: center;
}

.input-icon {
  position: absolute;
  left: 14px;
  color: #94a3b8;
  pointer-events: none;
}

.input-with-icon input {
  width: 100%;
  padding: 10px 14px 10px 42px;
  background-color: #ffffff;
  /* Light Grey background */
  border: 1px solid #cbd5e1;
  border-radius: 12px;
  font-size: 14px;
  color: #0f172a;
  font-family: 'Inter', sans-serif;
  transition: all 0.2s ease;
  outline: none;
}

.input-with-icon input:hover {
  border-color: #94a3b8;
}

.input-with-icon input:focus {
  background-color: #ffffff;
  border-color: #3b82f6;
  box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.1);
}

/* Captcha display input */
.form-group input[name="captchaInput"] {
  padding: 10px 14px;
  background-color: #ffffff;
  border: 1px solid #cbd5e1;
  border-radius: 12px;
  font-size: 14px;
  color: #0f172a;
  font-family: 'Inter', sans-serif;
  transition: all 0.2s ease;
  outline: none;
}

.form-group input[name="captchaInput"]:hover {
  border-color: #94a3b8;
}

.form-group input[name="captchaInput"]:focus {
  background-color: #ffffff;
  border-color: #3b82f6;
  box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.1);
}

.error-border {
  border-color: #ef4444 !important;
}

.error-text {
  color: #ef4444;
  font-size: 11px;
  font-weight: 500;
  margin-top: 4px;
}

.eye-toggle-btn {
  position: absolute;
  right: 14px;
  border: none;
  background: none;
  color: #94a3b8;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 4px;
  border-radius: 6px;
  transition: color 0.2s;
}

.eye-toggle-btn:hover {
  color: #3b82f6;
}

/* Override browser autofill color styling to keep backgrounds white */
.input-with-icon input:-webkit-autofill,
.input-with-icon input:-webkit-autofill:hover, 
.input-with-icon input:-webkit-autofill:focus, 
.input-with-icon input:-webkit-autofill:active {
  -webkit-box-shadow: 0 0 0 30px white inset !important;
  box-shadow: 0 0 0 30px white inset !important;
  -webkit-text-fill-color: #0f172a !important;
}

/* ── Captcha Section: Clean White with solid outline ── */
.captcha-section {
  display: flex;
  gap: 8px;
  margin: 4px 0 8px 0;
  height: 38px;
  width: 100%;
  max-width: 240px;
}

.captcha-code-container {
  flex: 1.1;
  background: #ffffff;
  border: 1px solid #cbd5e1;
  border-radius: 8px;
  padding: 4px;
  display: flex;
  align-items: center;
  justify-content: center;
  user-select: none;
  height: 100%;
}

.captcha-code {
  font-family: 'JetBrains Mono', 'Courier New', monospace;
  font-size: 15px;
  font-weight: 900;
  color: #ef4444;
  letter-spacing: 6px;
  text-indent: 6px;
  text-align: center;
  display: block;
}

.captcha-refresh-btn {
  flex: 0.7;
  background-color: #dc2626;
  border: 1px solid #dc2626;
  color: #ffffff;
  border-radius: 8px;
  padding: 0 12px;
  font-size: 11px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
  letter-spacing: 0.3px;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.captcha-refresh-btn:hover {
  background-color: #b91c1c;
  border-color: #b91c1c;
  transform: translateY(-1px);
  box-shadow: 0 4px 8px rgba(220, 38, 38, 0.2);
}

/* ── Form Options (Remember Me & Forgot Password) ── */
.form-options {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 8px;
  margin-bottom: 12px;
}

.checkbox-container {
  display: flex;
  align-items: center;
  position: relative;
  padding-left: 24px;
  cursor: pointer;
  font-size: 13px;
  color: #475569;
  user-select: none;
}

.checkbox-container input {
  position: absolute;
  opacity: 0;
  cursor: pointer;
  height: 0;
  width: 0;
}

.checkmark {
  position: absolute;
  top: 50%;
  left: 0;
  transform: translateY(-50%);
  height: 16px;
  width: 16px;
  background-color: #e2e8f0;
  border-radius: 4px;
  transition: background-color 0.2s;
}

.checkbox-container:hover input~.checkmark {
  background-color: #cbd5e1;
}

.checkbox-container input:checked~.checkmark {
  background-color: #3b82f6;
}

.checkmark::after {
  content: "";
  position: absolute;
  display: none;
}

.checkbox-container input:checked~.checkmark::after {
  display: block;
}

.checkbox-container .checkmark::after {
  left: 5px;
  top: 2px;
  width: 4px;
  height: 8px;
  border: solid white;
  border-width: 0 2px 2px 0;
  transform: rotate(45deg);
}

.forgot-password-link {
  font-size: 13px;
  color: #ef4444;
  text-decoration: none;
  font-weight: 600;
  transition: opacity 0.2s;
}

.forgot-password-link:hover {
  opacity: 0.8;
}

/* ── API Error Alert ── */
.api-error-alert {
  background-color: #fef2f2;
  border: 1px solid #fca5a5;
  color: #b91c1c;
  padding: 8px 12px;
  border-radius: 10px;
  font-size: 12px;
  margin-bottom: 10px;
  text-align: center;
}

/* ── Submit Button ── */
.login-submit-btn {
  width: 100%;
  padding: 10px;
  background: linear-gradient(135deg, #1d4ed8 0%, #3b82f6 100%);
  color: #ffffff;
  border: none;
  border-radius: 12px;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 0 4px 12px rgba(59, 130, 246, 0.2);
}

.login-submit-btn:hover {
  background: linear-gradient(135deg, #1e40af 0%, #2563eb 100%);
  box-shadow: 0 8px 24px rgba(37, 99, 235, 0.35);
  transform: translateY(-2px);
}

.login-submit-btn:active {
  transform: translateY(0);
}

.login-submit-btn:disabled {
  opacity: 0.6;
  cursor: not-allowed;
  transform: none;
  box-shadow: none;
}

/* ── Secure Badge ── */
.card-footer-info {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  margin-top: 10px;
  color: #94a3b8;
}

.security-icon {
  color: #22c55e;
}

.card-footer-info span {
  font-size: 12px;
  font-weight: 500;
}

/* ── Global Brand Logo: Transparent Backplate (Matches Reference) ── */
.global-brand-logo {
  position: absolute;
  top: 40px;
  left: 40px;
  z-index: 10;
}

.brand-logo {
  height: 48px;
  width: auto;
  object-fit: contain;
  mix-blend-mode: multiply;
}



/* ── Responsive Styling ── */
@media (max-width: 991px) {
  .left-side {
    display: none;
  }

  .right-side {
    flex: 1;
    justify-content: center;
  }

  .login-content-container {
    justify-content: center;
    padding: 0 20px;
  }

  .global-brand-logo {
    top: 24px;
    left: 24px;
  }
}

@media (max-width: 480px) {
  .login-box {
    padding: 28px 20px;
    border-radius: 20px;
  }

  .captcha-section {
    flex-direction: column;
    gap: 8px;
  }

  .captcha-refresh-btn {
    padding: 12px;
  }
}