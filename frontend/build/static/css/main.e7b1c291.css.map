.admin-convenience-edit-page {
  gap: 12px;
}

.admin-convenience-edit-head-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  flex-wrap: wrap;
}

.admin-convenience-edit-header h1 {
  font-size: 1.86rem;
  font-weight: 600;
}

.admin-convenience-list-btn {
  min-height: 34px;
  border: 0;
  border-radius: 9px;
  padding: 0 12px;
  color: #fff;
  font-size: 0.84rem;
  font-weight: 700;
  background: linear-gradient(135deg, var(--admin-primary), var(--admin-primary-strong));
  display: inline-flex;
  align-items: center;
  gap: 6px;
  cursor: pointer;
}

.admin-convenience-edit-shell {
  border: 1px solid var(--admin-border);
  border-radius: 10px;
  background: var(--admin-surface);
  overflow: hidden;
}

.admin-convenience-edit-row {
  display: grid;
  grid-template-columns: 1.2fr 2fr 1fr 2fr;
  border-top: 1px solid var(--admin-border);
}

.admin-convenience-edit-label {
  min-height: 48px;
  border-right: 1px dashed var(--admin-border);
  background: var(--admin-soft);
  color: var(--admin-text);
  display: inline-flex;
  align-items: center;
  padding: 0 10px;
  font-size: 1.03rem;
  font-weight: 500;
}

.admin-convenience-edit-field {
  min-height: 48px;
  border-right: 1px solid var(--admin-border);
  display: inline-flex;
  align-items: center;
  padding: 0 8px;
}

.admin-convenience-edit-field:last-child {
  border-right: 0;
}

.admin-convenience-edit-field input[type="number"],
.admin-convenience-edit-field select {
  width: 100%;
  min-height: 38px;
  border: 1px solid #d93025 !important;
  border-radius: 7px;
  background: var(--admin-surface);
  color: var(--admin-text);
  font-size: 1.02rem;
  font-weight: 400;
  padding: 0 10px;
}

.admin-convenience-toggle-label {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  cursor: pointer;
  font-size: 0.92rem;
  font-weight: 500;
  color: var(--admin-text);
  user-select: none;
}

.admin-convenience-toggle-label input[type="checkbox"] {
  width: 18px;
  min-width: 18px;
  height: 18px;
  min-height: 18px;
  cursor: pointer;
  accent-color: var(--admin-primary);
}

.admin-convenience-edit-actions {
  display: flex;
  justify-content: center;
  padding: 10px 0 12px;
}

.admin-convenience-update-btn {
  min-height: 40px;
  border: 2px solid var(--admin-primary);
  border-radius: 12px;
  background: var(--admin-surface);
  color: var(--admin-text);
  padding: 0 30px;
  font-size: 1.06rem;
  font-weight: 800;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  cursor: pointer;
}

.admin-convenience-update-btn:hover {
  background: var(--admin-soft);
}

.admin-convenience-update-btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

@media (max-width: 1100px) {
  .admin-convenience-edit-row {
    grid-template-columns: 1fr;
  }

  .admin-convenience-edit-label,
  .admin-convenience-edit-field {
    border-right: 0;
    border-bottom: 1px solid var(--admin-border);
  }

  .admin-convenience-edit-field:last-child {
    border-bottom: 0;
  }
}

@media (max-width: 620px) {
  .admin-convenience-list-btn {
    width: 100%;
    justify-content: center;
  }

  .admin-convenience-update-btn {
    width: 100%;
    max-width: 280px;
  }
}
