.admin-flight-search-history-page .admin-search-history-table-head,
.admin-flight-search-history-page .admin-search-history-row {
  grid-template-columns: 0.9fr 1.8fr 0.9fr 1.2fr 0.6fr !important;
}

.admin-search-history-delete {
  background: #A51C49 !important;
  color: #ffffff !important;
}

.admin-flight-search-history-page .admin-search-history-cell {
  display: flex !important;
  flex-direction: column !important;
  align-items: center !important;
  justify-content: center !important;
  text-align: center !important;
  padding: 8px !important;
  box-sizing: border-box !important;
}

.admin-flight-search-history-page .admin-search-history-cell small {
  font-size: 0.76rem;
  color: var(--admin-muted);
  text-align: center !important;
}

.admin-flight-search-view-btn {
  min-width: 36px;
  padding: 0 !important;
  display: grid;
  place-items: center;
}

@media (max-width: 820px) {
  .admin-flight-search-history-page .admin-search-history-table-head,
  .admin-flight-search-history-page .admin-search-history-row {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 620px) {
  .admin-flight-search-history-page .admin-search-history-table-head,
  .admin-flight-search-history-page .admin-search-history-row {
    grid-template-columns: 1fr;
  }
}

/* Modal Backdrop */
.admin-flight-search-history-page .admin-view-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.3) !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  z-index: 1200 !important;
  padding: 16px !important;
}

/* Modal Card */
.admin-flight-search-history-page .admin-view-card {
  background: var(--admin-surface) !important;
  border-radius: 18px !important;
  width: min(600px, 95vw) !important;
  box-shadow: 0 24px 48px rgba(15, 23, 42, 0.12) !important;
  border: 1px solid var(--admin-border) !important;
  padding: 18px !important;
  max-height: 88vh !important;
  overflow-y: auto !important;
  display: flex !important;
  flex-direction: column !important;
  gap: 16px !important;
  box-sizing: border-box !important;
  animation: modalFadeIn 0.3s ease !important;
}

@keyframes modalFadeIn {
  from {
    opacity: 0;
    transform: scale(0.96);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

/* Modal Header */
.admin-flight-search-history-page .admin-view-header {
  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;
  gap: 16px !important;
  padding-bottom: 12px !important;
  border-bottom: 1px solid var(--admin-border) !important;
}

.admin-flight-search-history-page .admin-view-header button {
  border: 1px solid var(--admin-border) !important;
  background: var(--admin-soft) !important;
  color: var(--admin-primary) !important;
  border-radius: 10px !important;
  padding: 6px 12px !important;
  font-weight: 600 !important;
  cursor: pointer !important;
}

.admin-flight-search-history-page .admin-view-header-main h2 {
  margin: 0 !important;
  font-size: 1.25rem !important;
  color: var(--admin-text) !important;
}

.admin-flight-search-history-page .admin-view-header-subtitle {
  margin: 4px 0 0 !important;
  color: var(--admin-muted) !important;
  font-size: 0.85rem !important;
}

/* Modal Grid */
.admin-flight-search-history-page .admin-view-grid {
  display: grid !important;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)) !important;
  gap: 14px !important;
  padding-top: 8px !important;
}

.admin-flight-search-history-page .admin-view-grid div {
  display: flex !important;
  flex-direction: column !important;
  gap: 4px !important;
}

.admin-flight-search-history-page .admin-view-grid span {
  font-size: 0.75rem !important;
  color: #0f172a !important;
  font-weight: 700 !important;
  text-transform: uppercase !important;
  letter-spacing: 0.04em !important;
}

.admin-flight-search-history-page .admin-view-grid strong {
  font-size: 0.95rem !important;
  color: #64748b !important;
  font-weight: 400 !important;
}

/* Dark Theme Overrides */
.admin-shell.dark-theme .admin-flight-search-history-page .admin-view-backdrop {
  background: rgba(0, 0, 0, 0.6) !important;
}

.admin-shell.dark-theme .admin-flight-search-history-page .admin-view-card {
  background: #0f172a !important;
  border-color: #1e293b !important;
}

.admin-shell.dark-theme .admin-flight-search-history-page .admin-view-header h2 {
  color: #ffffff !important;
}

.admin-shell.dark-theme .admin-flight-search-history-page .admin-view-header-subtitle {
  color: #94a3b8 !important;
}

.admin-shell.dark-theme .admin-flight-search-history-page .admin-view-grid span {
  color: #94a3b8 !important;
}

.admin-shell.dark-theme .admin-flight-search-history-page .admin-view-grid strong {
  color: #ffffff !important;
}

.admin-shell.dark-theme .admin-flight-search-history-page .admin-view-header button {
  background: #1e293b !important;
  color: #3b82f6 !important;
  border: 1px solid #334155 !important;
}

.admin-shell.dark-theme .admin-flight-search-history-page .admin-view-header button:hover {
  background: #3b82f6 !important;
  color: #ffffff !important;
}

.admin-flight-search-history-page .admin-search-history-cell strong {
  font-size: 0.81rem !important;
  font-weight: normal !important;
}

