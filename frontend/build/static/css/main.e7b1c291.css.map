.admin-flight-pending-edit-page {
  gap: 12px;
}

.admin-flight-pending-edit-head-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  flex-wrap: wrap;
}

.admin-flight-pending-edit-header h1 {
  font-size: 1.86rem;
  font-weight: 600 !important;
}

.admin-flight-pending-edit-list-btn {
  min-height: 34px;
  border: 0;
  border-radius: 10px;
  padding: 0 12px;
  color: #fff;
  font-size: 0.84rem;
  font-weight: 800;
  background: linear-gradient(135deg, var(--admin-primary), var(--admin-primary-strong));
  display: inline-flex;
  align-items: center;
  gap: 6px;
  cursor: pointer;
}

.admin-flight-pending-edit-shell {
  border: 1px solid var(--admin-border);
  border-radius: 12px;
  background: var(--admin-surface);
  overflow: hidden;
}

.admin-flight-pending-edit-grid {
  display: grid;
  grid-template-columns: 0.85fr 2.3fr 0.85fr 2.3fr;
  border-top: 1px solid var(--admin-border);
}

.admin-flight-pending-edit-label {
  min-height: 48px;
  border-right: 1px dashed var(--admin-border);
  border-bottom: 1px solid var(--admin-border);
  background: var(--admin-soft);
  color: var(--admin-text);
  display: inline-flex;
  align-items: center;
  padding: 0 10px;
  font-size: 1.02rem;
  font-weight: 800;
}

.admin-flight-pending-edit-field {
  min-height: 48px;
  border-right: 1px solid var(--admin-border);
  border-bottom: 1px solid var(--admin-border);
  display: flex;
  align-items: center;
  padding: 0 8px;
}

/* Remark field spans all 3 remaining columns */
.admin-flight-pending-edit-field-wide {
  grid-column: 2 / -1;
  border-right: 0;
}

/* Remove right border from last field in each row */
.admin-flight-pending-edit-field:nth-child(4n) {
  border-right: 0;
}

/* Remove bottom border on last row cells */
.admin-flight-pending-edit-grid > *:nth-last-child(-n+2) {
  border-bottom: 0;
}

.admin-flight-pending-edit-field input,
.admin-flight-pending-edit-field select {
  width: 100%;
  min-height: 38px;
  border: 1px solid var(--admin-border);
  border-radius: 9px;
  background: var(--admin-surface);
  color: var(--admin-text);
  font-size: 1.02rem;
  padding: 0 10px;
  box-sizing: border-box;
}

.admin-flight-pending-edit-field input:focus,
.admin-flight-pending-edit-field select:focus {
  outline: none;
  border-color: var(--admin-primary);
  box-shadow: 0 0 0 3px rgba(74, 15, 26, 0.14);
}

.admin-flight-pending-edit-actions {
  display: flex;
  justify-content: center;
  padding: 12px 0 14px;
}

.admin-flight-pending-submit-btn {
  min-height: 40px;
  border: 0;
  border-radius: 12px;
  padding: 0 34px;
  font-size: 1.02rem;
  font-weight: 900;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: #ffffff;
  background: linear-gradient(135deg, var(--admin-primary), var(--admin-primary-strong));
  box-shadow: 0 12px 20px rgba(47, 47, 47, 0.18);
  cursor: pointer;
}

@media (max-width: 1100px) {
  .admin-flight-pending-edit-grid {
    grid-template-columns: 1fr;
  }

  .admin-flight-pending-edit-label,
  .admin-flight-pending-edit-field {
    border-right: 0;
    border-bottom: 1px solid var(--admin-border);
  }

  .admin-flight-pending-edit-field-wide {
    grid-column: auto;
  }
}

@media (max-width: 620px) {
  .admin-flight-pending-edit-list-btn {
    width: 100%;
    justify-content: center;
  }

  .admin-flight-pending-submit-btn {
    width: 100%;
    max-width: 280px;
  }
}
