.admin-flight-pending-page {
  gap: 12px;
}

.admin-flight-pending-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  flex-wrap: wrap;
}

.admin-flight-pending-header h1 {
  font-size: 1.85rem;
  font-weight: 500 !important;
}

.admin-flight-pending-header h1 span {
  font-weight: 600 !important;
}

.admin-flight-pending-actions-row {
  gap: 6px;
}

.admin-flight-pending-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
}

.admin-flight-pending-btn.secondary {
  border: 1.5px solid #1e75ff !important;
  background: #1e75ff !important;
  color: #ffffff !important;
  box-shadow: 0 4px 10px rgba(30, 117, 255, 0.15) !important;
  transition: all 0.2s ease-in-out !important;
}

.admin-flight-pending-btn.secondary:hover {
  background: #0052d9 !important;
  border-color: #0052d9 !important;
  transform: translateY(-2px) !important;
}

.admin-flight-pending-table-head span {
  background: transparent !important;
  border-radius: 0 !important;
  box-shadow: none !important;
  font-weight: 600 !important;
  color: #ffffff !important;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 32px;
  font-size: 0.8rem;
}

.admin-flight-pending-table-head,
.admin-flight-pending-table-row {
  grid-template-columns: 0.3fr 0.35fr 0.8fr 1fr 1.15fr 1.05fr 1.6fr 1.05fr;
}

/* Make row a unified, cohesive container */
.admin-flight-pending-table-row {
  background: var(--admin-surface) !important;
  border: 1px solid var(--admin-border) !important;
  border-radius: 12px !important;
  padding: 0 !important;
  margin-bottom: 8px;
  overflow: hidden;
}

/* Reset cell box backgrounds, borders, and rounded corners so they flow horizontally */
.admin-flight-pending-table-row .admin-cancel-cell {
  background: transparent !important;
  border: none !important;
  border-radius: 0 !important;
  padding: 12px 8px !important;
  min-height: 48px !important;
  display: flex !important;
  flex-direction: column !important;
  align-items: center !important;
  justify-content: center !important;
  text-align: center !important;
  color: #64748b !important;
  font-weight: 500 !important;
  font-size: 0.84rem !important;
}

/* Add light vertical divider lines between columns */
.admin-flight-pending-table-row .admin-cancel-cell:not(:last-child) {
  border-right: 1px solid var(--admin-border) !important;
}

.admin-flight-pending-table-row .admin-flight-pending-action-cell {
  display: flex !important;
  flex-direction: row !important;
  justify-content: center !important;
  align-items: center !important;
  gap: 8px !important;
}

.admin-flight-pending-icon-btn {
  width: 34px;
  height: 34px;
  border-radius: 9px;
  border: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  cursor: pointer;
  transition: all 0.2s ease-in-out;
}

.admin-flight-pending-icon-btn.view {
  background: #A51C49 !important;
  box-shadow: 0 4px 10px rgba(194, 24, 91, 0.15);
}

.admin-flight-pending-icon-btn.view:hover {
  background: #9c1048 !important;
  transform: translateY(-2px);
}

.admin-flight-pending-icon-btn.edit {
  background: #A51C49 !important;
  box-shadow: 0 4px 10px rgba(194, 24, 91, 0.15);
}

.admin-flight-pending-icon-btn.edit:hover {
  background: #9c1048 !important;
  transform: translateY(-2px);
}

.admin-flight-pending-icon-btn.delete {
  background: linear-gradient(135deg, var(--admin-danger), var(--admin-primary-strong));
}

/* Modal Backdrop */
.admin-flight-pending-page .admin-view-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.3) !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  z-index: 1200 !important;
  padding: 16px !important;
}

/* Modal Card */
.admin-flight-pending-page .admin-view-card {
  background: var(--admin-surface) !important;
  border-radius: 18px !important;
  width: min(600px, 95vw) !important;
  box-shadow: 0 24px 48px rgba(15, 23, 42, 0.12) !important;
  border: 1px solid var(--admin-border) !important;
  padding: 18px !important;
  max-height: 88vh !important;
  overflow-y: auto !important;
  display: flex !important;
  flex-direction: column !important;
  gap: 16px !important;
  box-sizing: border-box !important;
  animation: modalFadeIn 0.3s ease !important;
}

@keyframes modalFadeIn {
  from {
    opacity: 0;
    transform: scale(0.96);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

/* Modal Header */
.admin-flight-pending-page .admin-view-header {
  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;
  gap: 16px !important;
  padding-bottom: 12px !important;
  border-bottom: 1px solid var(--admin-border) !important;
}

.admin-flight-pending-page .admin-view-header button {
  border: 1px solid var(--admin-border) !important;
  background: var(--admin-soft) !important;
  color: var(--admin-primary) !important;
  border-radius: 10px !important;
  padding: 6px 12px !important;
  font-weight: 600 !important;
  cursor: pointer !important;
}

.admin-flight-pending-page .admin-view-header-main h2 {
  margin: 0 !important;
  font-size: 1.25rem !important;
  color: var(--admin-text) !important;
}

.admin-flight-pending-page .admin-view-header-subtitle {
  margin: 4px 0 0 !important;
  color: var(--admin-muted) !important;
  font-size: 0.85rem !important;
}

/* Modal Grid */
.admin-flight-pending-page .admin-view-grid {
  display: grid !important;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)) !important;
  gap: 14px !important;
  padding-top: 8px !important;
}

.admin-flight-pending-page .admin-view-grid div {
  display: flex !important;
  flex-direction: column !important;
  gap: 4px !important;
}

.admin-flight-pending-page .admin-view-grid span {
  font-size: 0.75rem !important;
  color: #0f172a !important;
  font-weight: 700 !important;
  text-transform: uppercase !important;
  letter-spacing: 0.04em !important;
}

.admin-flight-pending-page .admin-view-grid strong {
  font-size: 0.95rem !important;
  color: #64748b !important;
  font-weight: 400 !important;
}

/* Dark Theme Overrides */
.admin-shell.dark-theme .admin-flight-pending-page .admin-view-backdrop {
  background: rgba(0, 0, 0, 0.6) !important;
}

.admin-shell.dark-theme .admin-flight-pending-page .admin-view-card {
  background: #0f172a !important;
  border-color: #1e293b !important;
}

.admin-shell.dark-theme .admin-flight-pending-page .admin-view-header h2 {
  color: #ffffff !important;
}

.admin-shell.dark-theme .admin-flight-pending-page .admin-view-header-subtitle {
  color: #94a3b8 !important;
}

.admin-shell.dark-theme .admin-flight-pending-page .admin-view-grid span {
  color: #94a3b8 !important;
}

.admin-shell.dark-theme .admin-flight-pending-page .admin-view-grid strong {
  color: #ffffff !important;
}

.admin-shell.dark-theme .admin-flight-pending-page .admin-view-header button {
  background: #1e293b !important;
  color: #3b82f6 !important;
  border: 1px solid #334155 !important;
}

.admin-shell.dark-theme .admin-flight-pending-page .admin-view-header button:hover {
  background: #3b82f6 !important;
  color: #ffffff !important;
}

@media (max-width: 980px) {
  .admin-flight-pending-table-head,
  .admin-flight-pending-table-row {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 620px) {
  .admin-flight-pending-table-head,
  .admin-flight-pending-table-row {
    grid-template-columns: 1fr;
  }
}

