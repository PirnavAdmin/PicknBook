.admin-convenience-page {
  gap: 12px;
}

.admin-convenience-header h1 {
  font-size: 1.86rem;
}

.admin-convenience-table-shell {
  border: 1px solid var(--admin-border);
  border-radius: 13px;
  overflow: hidden;
  background: var(--admin-surface);
  box-shadow: 0 10px 20px rgba(16, 34, 58, 0.08);
}

.admin-convenience-table-head {
  display: grid;
  grid-template-columns: 0.4fr 0.8fr 0.7fr 1fr 1fr 0.5fr;
  gap: 8px;
  padding: 8px;
  background: linear-gradient(135deg, var(--admin-primary), var(--admin-primary-strong));
}

.admin-convenience-table-head span {
  min-height: 32px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 0.8rem;
  font-weight: 600;
  text-align: center;
}

.admin-convenience-table-body {
  display: grid;
}

.admin-convenience-table-row {
  display: grid;
  grid-template-columns: 0.4fr 0.8fr 0.7fr 1fr 1fr 0.5fr;
  gap: 0;
  padding: 12px 8px;
  border-bottom: 1px solid var(--admin-border);
}

.admin-convenience-cell {
  min-height: 40px;
  border: none;
  border-radius: 0;
  background: transparent;
  padding: 8px 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  color: var(--admin-text);
  font-size: 0.85rem;
  font-weight: 400;
}

.admin-convenience-cell strong,
.admin-convenience-cell span {
  color: var(--admin-text);
  font-size: 0.85rem;
  font-weight: 400;
}

.admin-convenience-status-cell {
  justify-items: center;
  text-align: center;
}

.admin-convenience-status-dot {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 0.85rem;
  font-weight: 500;
}

.admin-convenience-status-dot .dot {
  width: 9px;
  height: 9px;
  border-radius: 50%;
  display: inline-block;
  flex-shrink: 0;
}

.admin-convenience-status-dot .dot.green {
  background: #28a745;
  box-shadow: 0 0 0 3px rgba(40, 167, 69, 0.18);
}

.admin-convenience-status-dot .dot.red {
  background: #be185d;
  box-shadow: 0 0 0 3px rgba(220, 53, 69, 0.18);
}

.admin-convenience-status-dot.active {
  color: #28a745;
}

.admin-convenience-status-dot.inactive {
  color: #be185d;
}

.admin-convenience-action-cell {
  justify-items: center;
  display: flex !important;
  align-items: center;
  justify-content: center;
  gap: 8px;
}

.admin-convenience-action-btn {
  width: 32px;
  height: 32px;
  border-radius: 8px;
  border: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  cursor: pointer;
  transition: all 0.2s ease;
}

.admin-convenience-action-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 3px 8px rgba(0,0,0,0.15);
}

.admin-convenience-action-btn.view {
  background: #17a2b8;
}

.admin-convenience-action-btn.edit {
  background: #A51C49;
}

.admin-convenience-action-btn.delete {
  background: #be185d;
}

.admin-convenience-icon-btn {
  width: 30px;
  height: 30px;
  border-radius: 7px;
  border: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  cursor: pointer;
}

.admin-convenience-icon-btn.edit {
  background: linear-gradient(135deg, var(--admin-primary), var(--admin-primary-strong));
}

.admin-convenience-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16px;
  padding: 40px 20px;
  border: 1px dashed var(--admin-border);
  border-radius: 13px;
  background: var(--admin-surface);
  color: var(--admin-text);
  font-size: 1rem;
  text-align: center;
}

.admin-convenience-empty .admin-convenience-icon-btn.edit {
  width: auto;
  height: auto;
  padding: 8px 16px;
  gap: 6px;
  font-size: 0.88rem;
  font-weight: 700;
  border-radius: 9px;
}

@media (max-width: 820px) {
  .admin-convenience-table-head,
  .admin-convenience-table-row {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 620px) {
  .admin-convenience-table-head,
  .admin-convenience-table-row {
    grid-template-columns: 1fr;
  }
}

.admin-convenience-modal-backdrop {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(16, 34, 58, 0.45);
  backdrop-filter: blur(4px);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.admin-convenience-modal {
  background: var(--admin-surface);
  border-radius: 14px;
  width: 90%;
  max-width: 480px;
  box-shadow: 0 15px 30px rgba(16, 34, 58, 0.15);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  animation: modal-pop 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes modal-pop {
  from { opacity: 0; transform: translateY(20px) scale(0.96); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

.admin-convenience-modal header {
  padding: 16px 20px;
  background: linear-gradient(135deg, var(--admin-primary), var(--admin-primary-strong));
  color: #fff;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.admin-convenience-modal header h2 {
  font-size: 1.15rem;
  margin: 0;
  font-weight: 700;
}

.admin-convenience-modal header button {
  background: transparent;
  border: none;
  color: rgba(255, 255, 255, 0.85);
  cursor: pointer;
  display: flex;
  padding: 4px;
  border-radius: 6px;
  transition: all 0.2s ease;
}

.admin-convenience-modal header button:hover {
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
}

.admin-convenience-modal-body {
  padding: 24px;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.admin-convenience-detail-row {
  display: flex;
  justify-content: space-between;
  padding-bottom: 10px;
  border-bottom: 1px dashed var(--admin-border);
}

.admin-convenience-detail-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.admin-convenience-detail-row strong {
  color: var(--admin-text-light);
  font-size: 0.88rem;
}

.admin-convenience-detail-row span {
  font-weight: 500;
  color: var(--admin-text);
  font-size: 0.95rem;
}

.form-body {
  gap: 8px;
}

.admin-convenience-edit-label {
  display: block;
  font-weight: 600;
  font-size: 0.85rem;
  color: var(--admin-text-light);
  margin-bottom: 4px;
  background: transparent !important;
  border: none !important;
  padding: 0 !important;
}

.admin-convenience-input {
  width: 100%;
  padding: 12px 14px;
  border-radius: 8px;
  border: 1px solid var(--admin-border);
  font-size: 0.95rem;
  background: var(--admin-background);
  color: var(--admin-text);
  outline: none;
  transition: all 0.2s ease;
}

.admin-convenience-input:focus {
  border-color: var(--admin-primary);
  box-shadow: 0 0 0 3px rgba(194, 24, 91, 0.1);
}

.admin-convenience-toggle-label {
  display: flex;
  align-items: center;
  gap: 10px;
  cursor: pointer;
  background: var(--admin-background);
  padding: 10px 14px;
  border-radius: 8px;
  border: 1px solid var(--admin-border);
}

.admin-convenience-toggle-label input[type="checkbox"] {
  width: 16px;
  height: 16px;
  accent-color: var(--admin-primary);
  cursor: pointer;
}

.admin-convenience-toggle-label span {
  font-size: 0.9rem;
  font-weight: 500;
  color: var(--admin-text);
}

.admin-convenience-modal-actions {
  display: flex;
  gap: 12px;
  justify-content: flex-end;
  margin-top: 20px;
}

.admin-convenience-modal-actions button {
  padding: 10px 20px;
  border-radius: 8px;
  font-weight: 600;
  font-size: 0.9rem;
  cursor: pointer;
  border: none;
  transition: all 0.2s ease;
}

.admin-convenience-modal-actions button.secondary {
  background: var(--admin-background);
  color: var(--admin-text-light);
  border: 1px solid var(--admin-border);
}

.admin-convenience-modal-actions button.secondary:hover {
  background: var(--admin-border);
  color: var(--admin-text);
}

.admin-convenience-modal-actions button.primary {
  background: linear-gradient(135deg, var(--admin-primary), var(--admin-primary-strong));
  color: #fff;
}

.admin-convenience-modal-actions button.primary:hover {
  box-shadow: 0 4px 12px rgba(194, 24, 91, 0.3);
  transform: translateY(-1px);
}

.admin-convenience-modal-actions button:disabled {
  opacity: 0.6;
  cursor: not-allowed;
  transform: none;
}

