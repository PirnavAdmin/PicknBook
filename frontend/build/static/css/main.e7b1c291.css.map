.bus-discount-mapping-page-container {
  --admin-primary: #A51C49 !important;
  --admin-primary-strong: #851237 !important;
}

.bus-discount-mapping-page-container .discount-heading {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: 4px;
}

.bus-discount-mapping-page-container .discount-heading-main {
  margin: 0;
  font-size: 22px !important;
  font-weight: 700 !important;
  color: var(--admin-primary) !important;
  letter-spacing: 0.02em;
}

.bus-discount-mapping-page-container .discount-heading-sub {
  font-size: 22px !important;
  font-weight: 700 !important;
  color: #000000 !important;
  margin-left: 8px !important;
}

.discount-mapping-container {
  display: flex;
  flex-direction: column;
  gap: 16px;
  width: 100%;
}

.mapping-selection-card {
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 20px 24px;
  background: var(--panel);
  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.02);
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.mapping-selection-card select {
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 10px 14px;
  font-size: 14px;
  color: var(--text);
  background: var(--admin-surface);
  min-height: 44px;
  width: 100%;
  outline: none;
  transition: all 0.2s ease-in-out;
  cursor: pointer;
}

.mapping-selection-card select:focus {
  border-color: var(--admin-primary);
  box-shadow: 0 0 0 3px rgba(74, 15, 26, 0.1);
}

.mapping-layout-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 24px;
  align-items: flex-start;
}

.details-panel {
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 24px;
  background: var(--panel);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.03);
  display: flex;
  flex-direction: column;
  gap: 20px;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.details-panel:hover {
  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.05);
}

.details-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16px;
  flex-wrap: wrap;
  border-bottom: 1px solid var(--border);
  padding-bottom: 16px;
  margin-bottom: 8px;
}

.details-title {
  font-size: 18px;
  font-weight: 700;
  color: var(--text);
  margin: 0;
  letter-spacing: -0.01em;
}

.details-subtitle {
  font-size: 13px;
  color: var(--muted);
  margin: 4px 0 0 0;
  line-height: 1.4;
}

.mapping-form-fields {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.bus-discount-mapping-page-container .field {
  display: flex;
  flex-direction: column;
  gap: 8px;
  font-size: 13px;
  font-weight: 500;
  color: var(--text);
}

.bus-discount-mapping-page-container .field span {
  font-size: 12px;
  font-weight: 700;
  color: #000000 !important;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.field input,
.field select {
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 11px 14px;
  font-size: 14px;
  color: var(--text);
  background: var(--admin-surface);
  min-height: 42px;
  width: 100%;
  outline: none;
  transition: all 0.2s ease;
}

.field input:focus,
.field select:focus {
  border-color: var(--admin-primary);
  box-shadow: 0 0 0 3px rgba(74, 15, 26, 0.10);
  background: var(--panel);
}

.form-actions {
  display: flex;
  gap: 12px;
  justify-content: flex-end;
  align-items: center;
  margin-top: 10px;
}

.primary-btn {
  border: 1.5px solid #A51C49 !important;
  background: #A51C49 !important;
  color: #fff !important;
  padding: 12px 20px;
  border-radius: 12px;
  font-weight: 600;
  font-size: 14px;
  cursor: pointer;
  box-shadow: 0 4px 12px rgba(194, 24, 91, 0.15) !important;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  white-space: nowrap;
  transition: all 0.25s ease !important;
}

.primary-btn:hover {
  background: #851237 !important;
  border-color: #851237 !important;
  transform: translateY(-3px) !important;
  box-shadow: 0 8px 18px rgba(194, 24, 91, 0.25) !important;
}

.primary-btn:disabled {
  opacity: 0.6;
  cursor: not-allowed;
  transform: none !important;
}

.ghost-btn {
  border: 1px solid var(--border);
  background: transparent;
  color: var(--text);
  padding: 12px 20px;
  border-radius: 12px;
  font-weight: 600;
  font-size: 14px;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  white-space: nowrap;
  transition: all 0.2s ease;
}

.ghost-btn:hover {
  background: var(--admin-soft);
  border-color: var(--admin-primary);
  color: var(--admin-primary);
}

.ghost-btn:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.danger-btn {
  border: 1px solid rgba(220, 53, 69, 0.2);
  background: rgba(220, 53, 69, 0.05);
  color: #be185d;
  padding: 12px 20px;
  border-radius: 12px;
  font-weight: 600;
  font-size: 14px;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  white-space: nowrap;
  transition: all 0.2s ease;
}

.danger-btn:hover {
  background: #be185d;
  color: #fff;
  border-color: #be185d;
  box-shadow: 0 4px 12px rgba(220, 53, 69, 0.2);
}

.danger-btn:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.small.icon-btn {
  width: 36px;
  height: 36px;
  padding: 0;
  border-radius: 10px;
}

.small.icon-btn svg {
  width: 14px;
  height: 14px;
}

.active-rules-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.rule-item-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 20px;
  background-color: var(--admin-soft);
  border: 1px solid var(--border);
  border-radius: 12px;
  box-shadow: 0 2px 6px rgba(0,0,0,0.01);
  transition: all 0.2s ease;
}

.rule-item-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 12px rgba(0, 0, 0, 0.04);
  border-color: var(--admin-primary);
}

.table-actions {
  display: flex;
  gap: 8px;
  align-items: center;
}

.table-actions .ghost-btn.small.icon-btn {
  background: #A51C49 !important;
  border-color: #A51C49 !important;
  color: #ffffff !important;
  transition: all 0.25s ease !important;
  box-shadow: 0 2px 6px rgba(194, 24, 91, 0.15) !important;
}

.table-actions .ghost-btn.small.icon-btn:hover {
  background: #851237 !important;
  border-color: #851237 !important;
  transform: translateY(-2px) !important;
}

.table-actions .danger-btn.small.icon-btn {
  background: #A51C49 !important;
  border-color: #A51C49 !important;
  color: #ffffff !important;
  transition: all 0.25s ease !important;
  box-shadow: 0 2px 6px rgba(194, 24, 91, 0.15) !important;
}

.table-actions .danger-btn.small.icon-btn:hover {
  background: #851237 !important;
  border-color: #851237 !important;
  transform: translateY(-2px) !important;
}

.mapping-placeholder-panel {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80px 40px;
  border: 2px dashed var(--border);
  border-radius: var(--radius);
  background: var(--panel);
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.01);
}

.form-error {
  background: rgba(220, 53, 69, 0.08);
  border: 1px solid rgba(220, 53, 69, 0.2);
  color: #be185d;
  padding: 10px 14px;
  border-radius: 8px;
  font-size: 13px;
  font-weight: 500;
  width: 100%;
  box-sizing: border-box;
}

@media (max-width: 850px) {
  .mapping-layout-grid {
    flex-direction: column;
  }
  .details-panel {
    flex: 1 1 100% !important;
    width: 100%;
  }
}

