* {
  box-sizing: border-box;
}

.about-container {
  padding: 10px 24px 24px 24px;
  background: transparent !important;
  min-height: 100vh;
  font-family: "Segoe UI", sans-serif;
  color: #333;
}

.about-container .top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
}

.about-container h2 {
  font-size: 1.8rem;
  font-weight: 500;
  color: #1e293b;
  margin: 0;
}

.about-container h2 span {
  color: #64748b;
}

.about-container .module-selector select {
  padding: 8px 14px;
  font-size: 14px;
  border: 1px solid #A51C49;
  border-radius: 8px;
  background: #A51C49;
  color: white;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
}

.about-container .module-selector select:hover {
  background: #851237;
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(194, 24, 91, 0.2);
}

.about-container .loading-state {
  text-align: center;
  padding: 40px;
  font-size: 16px;
  color: #666;
}

/* ── Section card ─────────────────────────────── */
.about-container .form-section {
  background: white;
  padding: 24px;
  border-radius: 12px;
  margin-bottom: 24px;
  border: 1px solid #e2e8f0;
  box-shadow: 0 10px 30px rgba(22, 65, 128, 0.04), 0 1px 3px rgba(22, 65, 128, 0.02);
}

/* ── Section header ribbon (Solid Cerise Pink) ─── */
.about-container .form-section > h3,
.about-container .section-header h3 {
  background: #A51C49 !important;
  border-bottom: none !important;
  color: #ffffff !important;
  padding: 8px 16px !important;
  margin: 0 0 20px 0;
  font-size: 14px;
  font-weight: 700;
  display: flex;
  align-items: center;
  overflow: hidden;
  border-radius: 6px !important;
  position: relative;
}

.about-container .form-section > h3::before,
.about-container .form-section > h3::after,
.about-container .section-header h3::before,
.about-container .section-header h3::after {
  display: none !important;
}

.about-container .form-section > h3 span.title-tab,
.about-container .section-header h3 span.title-tab {
  background: transparent !important;
  padding: 0 !important;
  clip-path: none !important;
  color: #ffffff !important;
}

/* ── Section header row (for sections with +Add button) ─── */
.about-container .section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 0;
  border: none;
  padding: 0;
}

.about-container .section-header h3 {
  flex: 1;
  margin-bottom: 0;
}

/* ── Form grid ────────────────────────────────── */
.about-container .form-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 15px;
  padding: 10px;
}

.about-container .form-group {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.about-container .form-group.wide {
  grid-column: span 2;
}

.about-container .form-group label {
  font-size: 13px;
  font-weight: 700;
  color: #000000 !important;
  text-transform: uppercase;
}

/* All input fields background white (empty of color) */
.about-container .form-group input,
.about-container .form-group select,
.about-container .form-group textarea,
.about-container .count-grid .count-pair input,
.about-container .about-sub-table input {
  padding: 8px 12px;
  border: 1px solid #cbd5e1 !important;
  border-radius: 6px;
  width: 100%;
  background: #ffffff !important;
  color: #1e293b !important;
  outline: none;
  font-family: inherit;
  font-size: 14px;
  transition: all 0.2s ease;
}

.about-container .form-group input:focus,
.about-container .form-group select:focus,
.about-container .form-group textarea:focus,
.about-container .count-grid .count-pair input:focus,
.about-container .about-sub-table input:focus {
  border-color: #A51C49 !important;
  box-shadow: 0 0 0 3px rgba(194, 24, 91, 0.15) !important;
}

.about-container .form-group textarea {
  resize: vertical;
  min-height: 100px;
}

/* ── Count section 2‑column card grid ─────────── */
.about-container .count-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 15px;
  padding: 10px;
}

.about-container .count-grid .count-pair {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.about-container .count-grid .count-pair label {
  font-size: 13px;
  font-weight: 700;
  color: #000000 !important;
  text-transform: uppercase;
}

.about-container .count-row-actions {
  display: flex;
  justify-content: flex-end;
  padding: 0 10px 10px;
}

/* ── Sub table (team members) ─────────────────── */
.about-container .about-sub-table {
  width: 100%;
  border-collapse: collapse;
}

.about-container .about-sub-table th {
  background: #A51C49 !important;
  color: #fff;
  font-size: 13px;
  padding: 10px;
  border: 1px solid #A51C49;
  text-align: center;
}

.about-container .about-sub-table td {
  padding: 10px;
  border: 1px solid #e2e8f0;
  text-align: center;
}

.about-container .about-sub-table td.empty-row {
  text-align: center;
  color: #888;
  padding: 20px;
}

/* ── Buttons ──────────────────────────────────── */
.about-container .add-row-btn {
  background: #A51C49 !important;
  color: white;
  border: none;
  padding: 8px 14px;
  border-radius: 8px;
  cursor: pointer;
  font-weight: 600;
  font-size: 13px;
  transition: all 0.2s ease;
  margin-left: 12px;
  flex-shrink: 0;
}

.about-container .add-row-btn:hover {
  background: #851237 !important;
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(194, 24, 91, 0.2);
}

.about-container .delete-row-btn {
  background: #ef4444;
  color: white;
  border: none;
  padding: 6px 10px;
  border-radius: 6px;
  cursor: pointer;
  transition: all 0.2s ease;
}

.about-container .delete-row-btn:hover {
  background: #dc2626;
  transform: translateY(-1px);
}

.about-container .action-td {
  text-align: center;
}

/* ── Messages ─────────────────────────────────── */
.about-container .error-msg {
  color: #e53935;
  font-weight: 600;
  margin-bottom: 15px;
}

.about-container .success-msg {
  color: #2e7d32;
  font-weight: 600;
  margin-bottom: 15px;
}

/* ── Submit ───────────────────────────────────── */
.about-container .submit-area {
  display: flex;
  justify-content: flex-end;
  margin-top: 10px;
  padding-top: 0px;
  border-top: none;
  margin-bottom: 30px;
}

.about-container .submit-btn {
  background: #10b981 !important;
  color: white !important;
  border: 1.5px solid #10b981 !important;
  padding: 10px 30px;
  border-radius: 8px;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.2s ease;
  font-size: 15px;
}

.about-container .submit-btn:hover {
  background: #059669 !important;
  border-color: #059669 !important;
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(16, 185, 129, 0.2);
}

.about-container .submit-btn:disabled {
  background: #ccc !important;
  border-color: #ccc !important;
  cursor: not-allowed;
  transform: none;
  box-shadow: none;
}

