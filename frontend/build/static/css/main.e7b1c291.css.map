.admin-markup-used-shell {
  --admin-primary: #A51C49 !important;
  --admin-primary-strong: #851237 !important;
  --primary: #A51C49 !important;
  --primary-strong: #851237 !important;
  display: grid;
  gap: 16px;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  box-sizing: border-box;
}

.admin-markup-used-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
}

.admin-markup-used-title-wrap {
  display: flex;
  align-items: center;
  gap: 10px;
}

.admin-markup-used-title-wrap h1 {
  margin: 0;
  font-size: 1.6rem;
  color: #000000 !important;
}

.admin-markup-used-title-line {
  height: 2px;
  width: 80px;
  background: var(--primary);
  border-radius: 999px;
}

.admin-markup-used-actions {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}

.admin-markup-used-btn {
  border: 1px solid var(--border);
  background: var(--panel);
  color: var(--text-primary);
  padding: 8px 14px;
  border-radius: 10px;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  cursor: pointer;
  transition: 0.2s ease;
}

.admin-markup-used-btn.filter.active,
.admin-markup-used-btn:hover {
  border-color: var(--primary);
  color: var(--primary);
  background: var(--surface-soft);
}

.admin-markup-used-btn.export {
  background: var(--success);
  color: #ffffff;
  border-color: var(--success);
}

.admin-markup-used-btn:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.admin-markup-used-filter {
  border: 1px solid var(--border);
  border-radius: 14px;
  background: var(--panel);
  padding: 14px;
  box-shadow: var(--shadow-sm);
}

.admin-markup-used-filter-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 12px;
}

.admin-markup-used-filter-grid label {
  display: grid;
  gap: 6px;
  font-size: 0.82rem;
  color: var(--text-secondary);
}

.admin-markup-used-filter-grid select {
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 8px 10px;
  background: var(--panel);
  color: var(--text-primary);
  font-size: 0.85rem;
}

.admin-markup-used-table-wrap {
  border: 1px solid var(--border);
  border-radius: 16px;
  background: var(--panel);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  width: 100%;
  max-width: 100%;
  min-width: 0;
  box-sizing: border-box;
}

.admin-markup-used-table-scroll {
  overflow-x: auto;
  width: 100%;
}

.admin-markup-used-table {
  width: 100% !important;
  border-collapse: collapse;
  font-size: 11px !important;
  min-width: 100% !important;
  table-layout: fixed;
}

.admin-markup-used-table th:nth-child(1), .admin-markup-used-table td:nth-child(1) { width: 4%; }
.admin-markup-used-table th:nth-child(2), .admin-markup-used-table td:nth-child(2) { width: 12%; }
.admin-markup-used-table th:nth-child(3), .admin-markup-used-table td:nth-child(3) { width: 12%; }
.admin-markup-used-table th:nth-child(4), .admin-markup-used-table td:nth-child(4) { width: 10%; }
.admin-markup-used-table th:nth-child(5), .admin-markup-used-table td:nth-child(5) { width: 15%; }
.admin-markup-used-table th:nth-child(6), .admin-markup-used-table td:nth-child(6) { width: 9%; }
.admin-markup-used-table th:nth-child(7), .admin-markup-used-table td:nth-child(7) { width: 9%; }
.admin-markup-used-table th:nth-child(8), .admin-markup-used-table td:nth-child(8) { width: 9%; }
.admin-markup-used-table th:nth-child(9), .admin-markup-used-table td:nth-child(9) { width: 9%; }
.admin-markup-used-table th:nth-child(10), .admin-markup-used-table td:nth-child(10) { width: 11%; }

.admin-markup-used-table thead {
  background: linear-gradient(135deg, var(--primary), var(--primary-strong));
  color: #ffffff;
}

.admin-markup-used-table th,
.admin-markup-used-table td {
  padding: 8px 6px !important;
  border-bottom: 1px solid var(--border);
  text-align: center !important;
  vertical-align: middle !important;
  text-overflow: ellipsis;
  white-space: nowrap;
  overflow: hidden;
}

.admin-markup-used-blank-row td {
  height: 120px;
  background: var(--surface-soft);
}

.admin-markup-used-status {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 4px 10px;
  border-radius: 999px;
  background: var(--surface-soft);
  border: 1px solid var(--border);
  font-size: 0.76rem;
  font-weight: 700;
  text-transform: capitalize;
}

.admin-markup-used-status.success {
  background: var(--success-soft);
  color: var(--success);
  border-color: rgba(30, 142, 62, 0.35);
}

.admin-markup-used-status.cancelled,
.admin-markup-used-status.failed {
  background: var(--danger-soft);
  color: var(--danger);
  border-color: rgba(180, 35, 24, 0.35);
}

.admin-markup-used-table .action-col {
  text-align: center;
}

.admin-markup-used-table .markup-action-group {
  display: inline-flex;
  align-items: center;
  gap: 8px;
}

.admin-markup-used-table .markup-action-group button {
  border: 1px solid var(--border);
  background: var(--surface-soft);
  color: var(--text-primary);
  width: 32px;
  height: 32px;
  border-radius: 8px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: 0.2s ease;
}

.admin-markup-used-table .markup-action-group button:hover {
  border-color: var(--primary);
  color: var(--primary);
}

.admin-markup-used-table .markup-action-group button.danger {
  border-color: rgba(217, 48, 37, 0.4);
  color: var(--danger);
  background: rgba(217, 48, 37, 0.12);
}

.admin-markup-used-empty,
.admin-markup-form-error {
  margin: 0;
  min-height: 80px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  width: 100%;
  color: var(--text-secondary);
  font-weight: 700;
}

.admin-markup-form-error {
  min-height: 0;
  justify-content: flex-start;
  color: var(--danger);
}

.admin-markup-used-empty .spin {
  animation: adminUsedCouponSpin 0.9s linear infinite;
}

@keyframes adminUsedCouponSpin {
  to {
    transform: rotate(360deg);
  }
}

@media (max-width: 900px) {
  .admin-markup-used-table thead {
    display: none;
  }

  .admin-markup-used-table tr {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 10px;
    padding: 12px;
    border-bottom: 1px solid var(--border);
  }

  .admin-markup-used-table td {
    border-bottom: 0;
  }
}


