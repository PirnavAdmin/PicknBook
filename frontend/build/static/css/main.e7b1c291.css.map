/* Container & Header */
.admin-markup-popular-shell {
  display: grid;
  gap: 24px;
  padding: 12px;
}

.admin-markup-popular-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
}

.admin-markup-popular-title-wrap {
  display: flex;
  align-items: center;
  gap: 12px;
}

.admin-markup-popular-title-wrap h1 {
  margin: 0;
  font-size: 1.85rem !important;
  color: var(--text-primary);
  font-weight: 800 !important;
}

.admin-markup-popular-title-wrap strong {
  color: #be185d;
  font-weight: 600;
}

.admin-markup-popular-title-line {
  height: 4px;
  width: 60px;
  background: #be185d;
  border-radius: 999px;
}

.admin-markup-popular-actions {
  display: flex;
  align-items: center;
  gap: 12px;
}

.admin-markup-popular-btn {
  border: 1.5px solid #be185d;
  background: transparent;
  color: #be185d;
  padding: 7px 14px;
  border-radius: 100px;
  font-weight: 600;
  font-size: 0.82rem;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  cursor: pointer;
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
}

.admin-markup-popular-btn:hover:not(:disabled) {
  background: #be185d;
  color: #ffffff;
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(190, 24, 93, 0.2);
}

.admin-markup-popular-btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

/* Stats Summary Cards */
.admin-popular-stats-grid {
  display: flex !important;
  flex-direction: row !important;
  justify-content: flex-start !important;
  gap: 12px !important;
  flex-wrap: wrap !important;
}

.admin-popular-stat-card {
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 12px 16px;
  background: var(--panel);
  box-shadow: 0 8px 20px rgba(15, 23, 42, 0.08);
  flex: 1;
  min-width: 180px;
  max-width: 280px !important;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.admin-popular-stat-card:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow-md);
}

.admin-popular-stat-card.searches {
  border-left: 4px solid #2563eb !important;
}

.admin-popular-stat-card.bookings {
  border-left: 4px solid #10b981 !important;
}

.admin-popular-stat-card.score {
  border-left: 4px solid #ef4444 !important;
}

.stat-label {
  font-size: 13px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: #2563eb; /* default blue, but we set individual styles below */
}

.admin-popular-stat-card.searches .stat-label {
  color: #2563eb !important;
}

.admin-popular-stat-card.bookings .stat-label {
  color: #10b981 !important;
}

.admin-popular-stat-card.score .stat-label {
  color: #ef4444 !important;
}

.stat-value {
  font-size: 28px;
  font-weight: 700;
  margin: 8px 0;
}

.admin-popular-stat-card.searches .stat-value {
  color: #1e40af !important;
}

.admin-popular-stat-card.bookings .stat-value {
  color: #047857 !important;
}

.admin-popular-stat-card.score .stat-value {
  color: #b91c1c !important;
}

.stat-meta {
  font-size: 12px;
  color: var(--muted);
}

/* Top Showcase Cards */
.admin-popular-showcase {
  display: grid;
  gap: 16px;
}

.showcase-title {
  margin: 0;
  font-size: 1.2rem;
  color: var(--text-primary);
  font-weight: 600;
}

.showcase-grid {
  display: flex;
  flex-direction: column;
  gap: 0px !important;
  align-items: flex-start;
}

.showcase-card {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 18px 20px;
  position: relative;
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  transition: transform 0.25s ease, box-shadow 0.25s ease;
  width: 100%;
  max-width: 100% !important;
}

.showcase-card:hover {
  transform: translateY(-3px);
  box-shadow: var(--shadow-md);
}

.showcase-card.rank-1 {
  border-left: 5px solid #f59f00; /* Gold */
  background: linear-gradient(to bottom right, var(--panel), rgba(245, 159, 0, 0.02));
}

.showcase-card.rank-2 {
  border-left: 5px solid #ced4da; /* Silver */
  background: linear-gradient(to bottom right, var(--panel), rgba(108, 117, 125, 0.02));
}

.showcase-card.rank-3 {
  border-left: 5px solid #e8590c; /* Bronze */
  background: linear-gradient(to bottom right, var(--panel), rgba(232, 89, 12, 0.02));
}

.card-badge {
  position: absolute;
  top: 16px;
  right: 16px;
  font-size: 1.4rem;
  font-weight: 800;
  opacity: 0.2;
}

.showcase-card.rank-1 .card-badge { color: #f59f00; opacity: 0.35; }
.showcase-card.rank-2 .card-badge { color: #868e96; opacity: 0.35; }
.showcase-card.rank-3 .card-badge { color: #e8590c; opacity: 0.35; }

.card-cities {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 20px;
  margin-top: 10px;
  width: 100%;
}

.city-name {
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--text-primary);
  flex: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.route-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  width: 60px;
}

.arrow-line {
  height: 2px;
  background: var(--border);
  flex: 1;
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
}

.arrow-bus-icon {
  background: var(--panel);
  padding: 0 4px;
  z-index: 1;
  color: var(--text-secondary);
}

.card-metrics-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
  background: var(--surface-soft);
  padding: 12px;
  border-radius: 12px;
}

.metric-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
}

.metric-label {
  font-size: 0.72rem;
  color: var(--text-secondary);
  text-transform: uppercase;
  font-weight: 600;
  letter-spacing: 0.03em;
}

.metric-val {
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--text-primary);
}

.metric-box.highlighted .metric-val {
  color: #be185d;
}

/* Filters & Search */
.admin-popular-filter-bar {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 16px 20px;
  display: flex;
  gap: 16px;
  flex-wrap: wrap;
}

.search-input-wrapper {
  position: relative;
  width: 100%;
  max-width: 480px;
}

.search-icon {
  position: absolute;
  left: 14px;
  top: 50%;
  transform: translateY(-50%);
  color: var(--text-secondary);
  pointer-events: none;
}

.search-input-wrapper input {
  width: 100%;
  padding: 10px 14px 10px 40px;
  border: 1px solid var(--border);
  border-radius: 12px;
  background: var(--panel);
  color: var(--text-primary);
  font-size: 0.9rem;
  outline: none;
  transition: all 0.2s ease;
}

.search-input-wrapper input:focus {
  border-color: #be185d;
  box-shadow: 0 0 0 3px rgba(190, 24, 93, 0.15);
}

/* Detailed Routes Table */
.admin-markup-popular-table-wrap {
  border: 1px solid var(--border);
  border-radius: 16px;
  background: var(--panel);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}

.admin-markup-popular-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.9rem;
}

.admin-markup-popular-table thead {
  background: var(--surface-soft);
  border-bottom: 2px solid var(--border);
}

.admin-markup-popular-table th {
  padding: 14px 16px;
  color: var(--text-secondary);
  font-weight: 600;
  text-align: left;
  font-size: 0.82rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.admin-markup-popular-table td {
  padding: 14px 16px;
  border-bottom: 1px solid var(--border);
  color: var(--text-primary);
}

.admin-markup-popular-table tr:last-child td {
  border-bottom: none;
}

.admin-popular-row-hover {
  transition: background-color 0.15s ease;
}

.admin-popular-row-hover:hover {
  background-color: var(--surface-soft);
}

.rank-cell {
  font-weight: 700;
  color: var(--text-secondary);
}

.city-cell {
  font-weight: 600;
}

.score-cell {
  font-weight: 700;
  color: #be185d;
}

/* Popularity Pills */
.popularity-pill {
  font-size: 0.76rem;
  font-weight: 700;
  padding: 6px 12px;
  border-radius: 100px;
  text-transform: uppercase;
  letter-spacing: 0.03em;
  display: inline-block;
}

.popularity-pill.high {
  background: rgba(190, 24, 93, 0.1);
  color: #be185d;
}

.popularity-pill.medium {
  background: var(--success-soft);
  color: var(--success);
}

.popularity-pill.trending {
  background: var(--info-soft);
  color: var(--info);
}

/* Empty, Error, Loading States */
.admin-popular-loading-state,
.admin-popular-error-state,
.admin-popular-empty-state {
  padding: 60px 20px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12px;
  color: var(--text-secondary);
  text-align: center;
}

.admin-popular-loading-state p,
.admin-popular-error-state p,
.admin-popular-empty-state p {
  margin: 0;
  font-size: 0.95rem;
}

.admin-popular-error-state button {
  background: #be185d;
  color: white;
  border: none;
  padding: 8px 24px;
  border-radius: 100px;
  font-weight: 600;
  cursor: pointer;
  font-size: 0.85rem;
  margin-top: 8px;
}

.admin-popular-error-state button:hover {
  background: #851237;
}

