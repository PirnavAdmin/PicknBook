.admin-portal-offer-management {
  width: 100%;
  min-width: 0;
}

.offer-add-page {
  width: 100%;
  min-width: 0;
  margin-top: 10px !important;
  padding: 20px 24px !important;
}

.offer-add-shell {
  margin-top: 12px;
  border: 1px solid var(--border, #ead6d6);
  border-radius: 16px;
  background: var(--panel, #ffffff);
  padding: 0 !important;
  box-shadow: var(--shadow-sm, 0 10px 28px rgba(80, 30, 30, 0.08));
  overflow: hidden;
}

.offer-add-form {
  display: flex;
  flex-direction: column;
  gap: 16px;
  padding: 20px;
}

/* Header inside container */
.offer-add-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20px 20px 0 20px;
}

body .offer-add-page .offer-add-heading,
.offer-add-heading {
  font-size: 1.5rem !important;
  font-weight: 500 !important;
  color: #A51C49 !important;
  margin: 0 !important;
}

.offer-add-list-btn {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 9px 22px;
  font-size: 0.85rem;
  font-weight: 600;
  color: #ffffff;
  background: #A51C49 !important;
  border: 2px solid #A51C49 !important;
  border-radius: 8px;
  cursor: pointer;
  transition: all 0.25s ease;
}

.offer-add-list-btn:hover {
  background: #851237 !important;
  border-color: #851237 !important;
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(165, 28, 73, 0.25);
}

/* Three columns with label above control */
.offer-add-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px 20px;
}

.offer-add-field {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.offer-add-label {
  color: #000000 !important;
  font-size: 0.85rem;
  font-weight: 700;
}

.offer-add-label span {
  color: var(--danger, #b42318);
}

.offer-add-control input,
.offer-add-control select,
.offer-add-short-textarea {
  width: 100%;
  min-width: 0;
  border: 1px solid var(--border, #e4caca);
  border-radius: 10px;
  background: var(--panel, #ffffff);
  color: var(--text-primary, #241414);
  font: inherit;
  font-size: 0.9rem;
  outline: none;
}

.offer-add-control input,
.offer-add-control select {
  height: 40px;
  padding: 8px 10px;
}

.offer-add-help {
  display: block;
  margin-top: 5px;
  color: var(--text-secondary, #664242);
  font-size: 0.76rem;
  font-weight: 600;
}

.offer-add-short-textarea {
  min-height: 96px;
  padding: 10px 12px;
  resize: vertical;
}

/* Description headings - removed background, decreased font weight, black color */
.offer-add-section-bar {
  display: flex;
  align-items: center;
  min-height: auto;
  border-radius: 0;
  background: transparent !important;
  color: #000000 !important;
  font-weight: 700 !important;
  padding: 4px 0;
  margin-top: 4px;
}

.offer-add-actions {
  margin-top: 8px;
  display: flex;
  justify-content: flex-end;
  gap: 12px;
}

.offer-add-actions button:disabled {
  cursor: not-allowed;
  opacity: 0.65;
}

.menu-form-success {
  margin: 0;
  color: var(--success, #1e8e3e);
  font-weight: 700;
}

/* Save / Primary Button */
.offer-add-actions button.primary {
  background: #A51C49 !important;
  border-color: #A51C49 !important;
  color: #ffffff !important;
  padding: 10px 24px !important;
  font-weight: 600 !important;
  border-radius: 8px !important;
  cursor: pointer !important;
  transition: all 0.25s ease-in-out !important;
}

/* Reset / Secondary Button */
.offer-add-actions button.secondary {
  background: transparent !important;
  border: 2px solid #A51C49 !important;
  color: #A51C49 !important;
  padding: 10px 24px !important;
  font-weight: 600 !important;
  border-radius: 8px !important;
  cursor: pointer !important;
  transition: all 0.25s ease-in-out !important;
}

.offer-add-actions button.primary:hover {
  background: #851237 !important;
  border-color: #851237 !important;
  transform: translateY(-2px) !important;
}

.offer-add-actions button.secondary:hover {
  background: rgba(165, 28, 73, 0.05) !important;
  transform: translateY(-2px) !important;
}

@media (max-width: 992px) {
  .offer-add-grid {
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
}

@media (max-width: 600px) {
  .offer-add-grid {
    grid-template-columns: 1fr;
    gap: 12px;
  }
}
