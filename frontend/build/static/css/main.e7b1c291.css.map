.page-container {
  padding: 20px;
  background: #f5f6f8;
  min-height: 100vh;
  font-family: "Segoe UI", sans-serif;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15px;
}

.header h2 {
  font-size: 1.8rem;
  font-weight: 600;
  color: #1e293b;
  margin: 0;
}


body .page-container .header .add-btn,
body .add-btn,
.add-btn {
  background: #A51C49 !important;
  color: white !important;
  border: none !important;
  padding: 8px 14px;
  border-radius: 8px;
  cursor: pointer;
  font-weight: 600;
  transition: all 0.2s ease;
}

body .page-container .header .add-btn:hover,
body .add-btn:hover,
.add-btn:hover {
  background: #851237 !important;
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(194, 24, 91, 0.2);
}

.page-table {
  width: 100%;
  border-collapse: collapse;
  background: white;
  border-radius: 6px;
  overflow: hidden;
}

.page-table th {
  background: #A51C49 !important;
  color: white;
  padding: 10px;
  font-size: 14px;
  text-align: center;
  font-weight: 600;
}

.page-table td {
  padding: 10px;
  border-bottom: 1px solid #ddd;
  font-size: 14px;
  text-align: center;
  vertical-align: middle;
}

.status.active {
  background: rgba(30, 142, 62, 0.12);
  color: var(--success);
  padding: 6px 10px;
  border-radius: 6px;
  font-size: 12px;
  font-weight: 600;
  border: 1px solid rgba(30, 142, 62, 0.3);
}

.status.inactive {
  background: rgba(217, 48, 37, 0.12);
  color: var(--danger);
  padding: 6px 10px;
  border-radius: 6px;
  font-size: 12px;
  font-weight: 600;
  border: 1px solid rgba(217, 48, 37, 0.3);
}

.action-btn {
  width: 32px;
  height: 32px;
  border-radius: 8px;
  border: 1.5px solid var(--border);
  font-weight: 700;
  cursor: pointer;
  transition: all 0.3s ease;
  background: var(--surface-soft);
  color: var(--text-primary);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

.view-btn-icon:hover {
  background: rgba(74, 15, 26, 0.15);
  border-color: var(--primary);
  transform: scale(1.08);
}

.edit-btn-icon:hover {
  background: rgba(74, 15, 26, 0.15);
  border-color: var(--primary);
  transform: scale(1.08);
}

.delete-btn-icon {
  background: rgba(217, 48, 37, 0.15);
  color: var(--danger);
  border-color: rgba(217, 48, 37, 0.35);
}

.delete-btn-icon:hover {
  background: rgba(217, 48, 37, 0.22);
  border-color: var(--danger);
  transform: scale(1.08);
}

/* Pagination Styles */
.pagination {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px 24px;
  background: white;
  border-top: 1px solid #ddd;
  gap: 12px;
  border-radius: 0 0 6px 6px;
  box-shadow: var(--shadow-sm);
}

.pagination-info {
  font-size: 0.85rem;
  color: #64748b;
  font-weight: 500;
}

.page-numbers {
  display: flex;
  gap: 6px;
  align-items: center;
}

.page-btn {
  padding: 6px 12px;
  border: 1px solid #ddd;
  background: white;
  color: #1e293b;
  border-radius: 6px;
  cursor: pointer;
  font-size: 0.85rem;
  font-weight: 600;
  transition: all 0.2s ease;
}

.page-btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.page-no-btn {
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid #ddd;
  background: white;
  color: #1e293b;
  border-radius: 6px;
  cursor: pointer;
  font-size: 0.85rem;
  font-weight: 600;
  transition: all 0.2s ease;
}

.page-no-btn.active {
  background: #A51C49;
  color: white;
  border-color: #A51C49;
}


