.admin-booking-page .admin-table-shell {
  border-color: var(--admin-border);
  background: var(--admin-surface);
  box-shadow: 0 10px 20px rgba(31, 31, 31, 0.08);
}

.admin-booking-page .admin-heading-red {
  color: #A51C49 !important;
}

.admin-booking-page .admin-table-head {
  background: linear-gradient(135deg, #A51C49, #851237);
}

.admin-booking-page .admin-table-head span {
  background: transparent !important;
  box-shadow: none !important;
}

.admin-booking-page .admin-table-row {
  border-top-color: var(--admin-border);
}

.admin-booking-page .admin-table-cell {
  border-color: var(--admin-border);
  background: #ffffff;
  color: var(--admin-text);
  min-width: 0;
}

.admin-booking-page .admin-table-cell strong {
  color: var(--admin-text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
  display: block;
}

.admin-booking-page .admin-table-cell small {
  color: var(--admin-muted);
}

.admin-booking-page .admin-status-pill.success {
  background: #e6f4ea;
  color: #137333;
  border: 1.5px solid #137333;
  cursor: pointer;
  transition: all 0.2s ease-in-out;
}

.admin-booking-page .admin-status-pill.success:hover {
  background: #137333;
  color: #ffffff;
}

.admin-booking-page .admin-status-pill.pending {
  background: #fff3cd;
  color: #b06000;
  border: 1.5px solid #b06000;
  cursor: pointer;
  transition: all 0.2s ease-in-out;
}

.admin-booking-page .admin-status-pill.pending:hover {
  background: #b06000;
  color: #ffffff;
}

.admin-booking-page .admin-status-pill.cancelled {
  background: #fce8e6;
  color: #c5221f;
  border: 1.5px solid #c5221f;
  cursor: pointer;
  transition: all 0.2s ease-in-out;
}

.admin-booking-page .admin-status-pill.cancelled:hover {
  background: #c5221f;
  color: #ffffff;
}

.admin-booking-page .text-success {
  color: #137333 !important;
}

.admin-booking-page .text-warning {
  color: #b06000 !important;
}

.admin-booking-page .admin-profit-value.loss {
  color: #c5221f !important;
}

.admin-booking-page .admin-profit-value.gain {
  color: #137333 !important;
}

.admin-booking-page .admin-table-footnote {
  border-top-color: var(--admin-border);
  background: var(--admin-soft);
  color: var(--admin-text);
}

.admin-booking-page .admin-total-chip {
  background: var(--admin-primary);
  color: #ffffff;
  border-color: var(--admin-primary);
}

.admin-booking-page .admin-stat-grid {
  display: flex;
  gap: 16px;
  align-items: stretch;
  flex-wrap: wrap;
}

.admin-booking-page .admin-stat-card {
  border: 1px solid var(--admin-border);
  background: var(--admin-surface);
  border-radius: 14px;
  padding: 14px;
  box-shadow: 0 8px 18px rgba(15, 23, 42, 0.03);
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 6px;
  flex: 1;
  min-width: 180px;
}

.admin-booking-page .admin-stat-card strong {
  font-size: 1.2rem;
  color: var(--admin-primary);
}

.admin-booking-page .admin-stat-card span {
  font-size: 0.85rem;
  color: var(--admin-muted);
}

.admin-booking-page .admin-stat-stack {
  display: flex;
  flex-direction: column;
  gap: 8px;
  justify-content: space-between;
  flex: 1;
  min-width: 180px;
}

.admin-booking-page .admin-stat-stack button {
  flex: 1;
  border: 1.5px solid #A51C49;
  background: #ffffff;
  color: #000000;
  padding: 8px 10px;
  border-radius: 10px;
  font-weight: 600;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
  transition: all 0.2s ease-in-out;
}

.admin-booking-page .admin-stat-stack button:hover {
  background: #A51C49;
  color: #ffffff;
}

.admin-booking-page .admin-table-head {
  display: grid;
  grid-template-columns: 0.6fr 1.4fr 1.3fr 1.0fr 1.8fr 1.3fr 0.7fr 0.9fr 0.6fr;
  gap: 8px;
  align-items: center;
}

.admin-booking-page .admin-table-body {
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding: 12px;
}

.admin-booking-page .admin-table-row {
  display: grid;
  grid-template-columns: 0.6fr 1.4fr 1.3fr 1.0fr 1.8fr 1.3fr 0.7fr 0.9fr 0.6fr;
  gap: 8px;
  padding: 10px;
  border-radius: 14px;
  background: var(--admin-surface);
  align-items: stretch; /* Stretch cells to equal height */
}

.admin-booking-page .admin-table-cell {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 4px;
  padding: 10px 12px;
  border-radius: 12px;
  min-width: 0;
  border: 1px solid var(--admin-border);
  background: #ffffff;
}

.admin-booking-page .admin-table-cell small {
  font-size: 0.75rem;
}

.admin-booking-page .admin-cell-centered {
  text-align: center;
  align-items: center;
}

/* Style specific columns for better readability and fitting */
.admin-booking-page .admin-table-cell:nth-child(1) strong {
  color: var(--admin-primary);
}

.admin-booking-page .admin-table-cell:nth-child(5) strong {
  font-family: monospace;
  font-size: 0.85rem;
  letter-spacing: -0.01em;
}

.admin-booking-page .admin-status-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 4px 10px;
  border-radius: 999px;
  font-size: 0.72rem;
  font-weight: 700;
  text-transform: capitalize;
}

.admin-booking-page .admin-action-btn {
  border: 1.5px solid #1a73e8;
  background: #e8f0fe;
  color: #1a73e8;
  padding: 6px 12px;
  border-radius: 10px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease-in-out;
}

.admin-booking-page .admin-action-btn:hover {
  background: #1a73e8;
  color: #ffffff;
}

.admin-booking-page .admin-table-empty {
  padding: 16px;
  text-align: center;
  color: var(--admin-muted);
  font-weight: 600;
}

.admin-booking-page .admin-view-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1200;
  padding: 16px;
}

.admin-booking-page .admin-view-card {
  background: var(--admin-surface);
  border-radius: 18px;
  width: min(900px, 95vw);
  box-shadow: 0 24px 48px rgba(15, 23, 42, 0.12);
  border: 1px solid var(--admin-border);
  padding: 18px;
}

.admin-booking-page .admin-view-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
  padding-bottom: 12px;
  border-bottom: 1px solid var(--admin-border);
}

.admin-booking-page .admin-view-header button {
  border: 1px solid var(--admin-border);
  background: var(--admin-soft);
  color: var(--admin-primary);
  border-radius: 10px;
  padding: 6px 12px;
  font-weight: 600;
  cursor: pointer;
}

.admin-booking-page .admin-view-header-subtitle {
  margin: 6px 0 0;
  color: var(--admin-muted);
  font-size: 0.85rem;
}

.admin-booking-page .admin-view-meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 10px;
}

.admin-booking-page .admin-view-meta-chip {
  padding: 6px 12px;
  border-radius: 999px;
  border: 1px solid var(--admin-border);
  background: var(--admin-soft);
  font-size: 0.75rem;
  font-weight: 700;
  color: var(--admin-primary);
}

.admin-booking-page .admin-view-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 14px;
  padding-top: 16px;
}

.admin-booking-page .admin-view-grid span {
  display: block;
  font-size: 0.75rem;
  color: var(--admin-muted);
  text-transform: uppercase;
  letter-spacing: 0.04em;
  margin-bottom: 6px;
}

.admin-booking-page .admin-view-grid strong {
  font-size: 0.95rem;
  color: var(--admin-text);
}

.admin-booking-page .admin-view-highlight-card {
  border-radius: 14px;
  border: 1px solid var(--admin-border);
  padding: 12px;
  background: var(--admin-soft);
  display: grid;
  gap: 6px;
}

@media (max-width: 1100px) {
  .admin-booking-page .admin-table-head,
  .admin-booking-page .admin-table-row {
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  }
}

@media (max-width: 720px) {
  .admin-booking-page .admin-table-head {
    display: none;
  }

  .admin-booking-page .admin-table-row {
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  }
}

/* Toolbar equal line alignment and premium button colors */
.admin-booking-page .admin-toolbar-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  flex-wrap: wrap;
}

.admin-booking-page .admin-chip-row {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}

.admin-booking-page .admin-actions-row {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}

/* Make both chips and buttons have exactly the same height and alignment */
.admin-booking-page .admin-chip,
.admin-booking-page .admin-actions-row button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 36px;
  box-sizing: border-box;
  font-size: 13px;
  font-weight: 600;
  border-radius: 999px; /* Make buttons also pills to align beautifully with chips */
  padding: 0 16px;
  transition: all 0.2s ease-in-out;
}

.admin-booking-page .admin-chip {
  background: #ffffff;
  color: #A51C49;
  border: 1.5px solid #A51C49 !important;
}

/* Specific styling for the total chip */
.admin-booking-page .admin-total-chip {
  background: #A51C49 !important;
  color: #ffffff !important;
  border: 1.5px solid #A51C49 !important;
}

/* Open Filter / Close Filter button */
.admin-booking-page .admin-actions-row button:first-child {
  background: #ffffff;
  color: #000000;
  border: 1.5px solid #A51C49;
  cursor: pointer;
}

.admin-booking-page .admin-actions-row button:first-child:hover {
  background: #A51C49;
  color: #ffffff;
  box-shadow: 0 4px 12px rgba(194, 24, 91, 0.2);
}

/* Export button */
.admin-booking-page .admin-actions-row button:last-child {
  background: #ffffff;
  color: #000000;
  border: 1.5px solid #A51C49;
  cursor: pointer;
}

.admin-booking-page .admin-actions-row button:last-child:hover {
  background: #A51C49;
  color: #ffffff;
  box-shadow: 0 4px 12px rgba(194, 24, 91, 0.2);
}

/* Pagination container styles */
.admin-pagination-container {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14px 16px;
  background: var(--admin-surface);
  border-top: 1px solid var(--admin-border);
  border-bottom-left-radius: 14px;
  border-bottom-right-radius: 14px;
  flex-wrap: wrap;
  gap: 12px;
}

.admin-pagination-info {
  font-size: 0.85rem;
  color: var(--admin-muted);
}

.admin-pagination-controls {
  display: flex;
  align-items: center;
  gap: 6px;
}

.admin-pagination-controls button {
  height: 32px;
  min-width: 32px;
  padding: 0 10px;
  border: 1.5px solid var(--admin-border);
  background: #ffffff;
  color: var(--admin-text);
  font-size: 0.85rem;
  font-weight: 600;
  border-radius: 8px;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease-in-out;
}

.admin-pagination-controls button:hover:not(:disabled) {
  border-color: #A51C49;
  color: #A51C49;
}

.admin-pagination-controls button.active {
  background: #A51C49;
  border-color: #A51C49;
  color: #ffffff;
}

.admin-pagination-controls button:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.pagination-ellipsis {
  color: var(--admin-muted);
  padding: 0 4px;
}

.admin-pagination-size {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.85rem;
  color: var(--admin-muted);
}

.admin-pagination-size select {
  height: 32px;
  padding: 0 8px;
  border: 1.5px solid var(--admin-border);
  border-radius: 8px;
  background: #ffffff;
  font-weight: 600;
  color: var(--admin-text);
  cursor: pointer;
}

/* Route Segment & Date styles */
.admin-route-segment {
  display: flex;
  align-items: center;
  gap: 6px;
  font-weight: 700;
  color: var(--admin-text);
  font-size: 0.9rem;
  flex-wrap: wrap;
}

.admin-segment-arrow {
  color: var(--admin-primary);
  font-weight: bold;
  font-size: 0.95rem;
}

.admin-date-badge {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  margin-top: 4px;
  color: var(--admin-muted);
  font-size: 0.76rem;
  font-weight: 600;
}

.admin-calendar-emoji {
  font-size: 0.85rem;
}

